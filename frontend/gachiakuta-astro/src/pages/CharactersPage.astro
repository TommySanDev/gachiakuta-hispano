---
import HeaderLayout from '../layouts/HeaderLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getAllCharacters } from '../lib/character-api';
import type { Character } from '../types/character';

const url = new URL(Astro.request.url);
let characters: Character[] = [];

try {
  characters = await getAllCharacters();
} catch (error) {
  console.error("Failed to load characters", error);
}
---

<HeaderLayout title="Characters - Gachiakuta Hispano">
  <div class="min-h-screen bg-gradient-to-br from-[#4b0000] to-black pb-20">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-20 left-10 w-64 h-64 bg-red-700 rounded-full opacity-10"></div>
      <div class="absolute bottom-40 right-20 w-96 h-96 bg-red-600 rounded-full opacity-5"></div>
    </div>

    <div class="relative z-10 text-center py-10 mb-4">
      <h1 class="text-5xl font-bold text-white drop-shadow-md">
        <span class="inline-block transform hover:scale-105 transition-transform">Characters</span>
      </h1>
    </div>

    <div class="max-w-6xl mx-auto px-8 relative z-10">
      <div class="h-0.5 bg-gradient-to-r from-transparent via-red-500 to-transparent opacity-50 mb-16"></div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-x-28 gap-y-32 max-w-6xl mx-auto px-8 place-items-start mt-16">
      {characters.map((char) => (
        <a href={`/characters/${char.id}`} class="block">
          <ContentCard name={char.name} imageUrl={char.main_image} />
        </a>
      ))}
    </div>
  </div>
</HeaderLayout>

