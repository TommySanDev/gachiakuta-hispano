---
import "../styles/global.css";
---

<div class="flex flex-col items-center justify-center min-h-screen bg-red-800 px-6 py-12">
  <div class="max-w-3xl text-center">
    <h1 class="text-5xl md:text-6xl font-bold text-white mb-12">Gachiakuta Hispano</h1>
    
    <div class="bg-black bg-opacity-30 rounded-lg p-8 mb-12">
      <h2 class="text-2xl md:text-3xl mb-6 text-white">Bienvenido a la fan page hispana de Gachiakuta</h2>
      <p class="text-gray-100 leading-relaxed">
        Encuentra toda la información sobre tus personajes favoritos, vital instruments, ubicaciones y más del universo de Gachiakuta.
      </p>
    </div>
    
    <div class="flex justify-center gap-6 mt-8">
      <a href="/CharactersPage" class="bg-gray-800 hover:bg-gray-700 text-white font-bold py-3 px-8 rounded-md transition-colors">
        Ver Personajes
      </a>
    </div>
  </div>
</div>
