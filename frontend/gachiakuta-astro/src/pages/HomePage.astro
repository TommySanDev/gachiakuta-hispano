---
// HomePage.astro
---
  <div class="min-h-screen bg-gradient-to-br from-[#4b0000] to-black flex items-center justify-center px-4">

    <!-- Zona central estilo papel -->
    <div class="bg-[#f5f1e6] w-full max-w-6xl px-6 py-16 shadow-inner rounded-sm flex justify-between items-end border-y-8 border-black relative">

      <!-- Líneas divisorias -->
      <div class="absolute top-0 bottom-0 left-1/5 w-px bg-black opacity-30"></div>
      <div class="absolute top-0 bottom-0 left-2/5 w-px bg-black opacity-30"></div>
      <div class="absolute top-0 bottom-0 left-3/5 w-px bg-black opacity-30"></div>
      <div class="absolute top-0 bottom-0 left-4/5 w-px bg-black opacity-30"></div>

      <!-- PERSONAJES -->
      <a href="/CharactersPage" class="group flex flex-col items-center w-1/5">
        <div class="vertical-title-wrapper">
          <div class="vertical-title">
            {Array.from("Personajes").map(letter => <span>{letter}</span>)}
          </div>
        </div>
        <div class="section-code">005</div>
      </a>

      <!-- INSTRUMENTOS VITALES -->
      <a href="/ViPage" class="group flex flex-col items-center w-1/5">
        <div class="vertical-title-wrapper flex-row gap-8">
          <div class="vertical-title items-end">
            {Array.from("Instrumentos").map(letter => <span>{letter}</span>)}
          </div>
          <div class="vertical-title items-start">
            {Array.from("Vitales").map(letter => <span>{letter}</span>)}
          </div>
        </div>
        <div class="section-code">025</div>
      </a>

      <!-- CAPÍTULOS -->
      <a href="/ChaptersPage" class="group flex flex-col items-center w-1/5">
        <div class="vertical-title-wrapper">
          <div class="vertical-title">
            {Array.from("Capítulos").map(letter => <span>{letter}</span>)}
          </div>
        </div>
        <div class="section-code">045</div>
      </a>

      <!-- FAVORITOS -->
      <a href="/favorites" class="group flex flex-col items-center w-1/5">
        <div class="vertical-title-wrapper">
          <div class="vertical-title">
            {Array.from("Favoritos").map(letter => <span>{letter}</span>)}
          </div>
        </div>
        <div class="section-code">065</div>
      </a>

      <!-- PERFIL -->
      <a href="/auth/profile" class="group flex flex-col items-center w-1/5">
        <div class="vertical-title-wrapper">
          <div class="vertical-title">
            {Array.from("Perfil").map(letter => <span>{letter}</span>)}
          </div>
        </div>
        <div class="section-code">085</div>
      </a>

    </div>
  </div>

<style>
  .vertical-title-wrapper {
    display: flex;
    min-height: 280px;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    color: black;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .vertical-title-wrapper:hover {
    opacity: 1;
  }

  .vertical-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .section-code {
    color: black;
    font-size: 0.75rem;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  a.group:hover .section-code {
    opacity: 1;
  }
</style>

