---
import TVLayout from '../../layouts/TVLayout.astro';
import { getCharacterById, getAllCharacters } from '../../lib/character-api';
import { imageMap } from '../../lib/image-map';
import { Image } from 'astro:assets';

const { params } = Astro;
const id = params.id;

let character = undefined;

try {
  character = await getCharacterById(id);
} catch (error) {
  throw new Error(`Character with id ${id} not found.`);
}

const imageFilename = character.main_image.split('/').pop();
const image = imageFilename ? imageMap[imageFilename] : undefined;

export async function getStaticPaths() {
  const characters = await getAllCharacters();

  return characters.map((char) => ({
    params: { id: String(char.id) }
  }));
}
---

<TVLayout title={`${character.name} - Gachiakuta Hispano`}>
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-black text-white py-16 px-8 max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="flex-shrink-0 w-full md:w-[260px]">
        {image && (
          <Image
            src={image}
            alt={character.name}
            width={360}
            height={240}
            layout="fixed"
            fit="cover"
            position="top"
            class="rounded shadow-lg"
          />
        )}
      </div>

      <div class="flex-1 space-y-4">
        <h1 class="text-4xl font-bold">{character.name}</h1>
        <h2 class="text-lg text-red-400 italic">{character.name_japanese}</h2>

        <p class="mt-6 text-lg leading-relaxed">{character.description}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6 text-sm">
          <div><strong>Species:</strong> {character.species}</div>
          <div><strong>Gender:</strong> {character.gender}</div>
          <div><strong>Age:</strong> {character.age}</div>
          <div><strong>Height:</strong> {character.height}</div>
          <div><strong>Status:</strong> {character.status}</div>
          <div><strong>Affiliation:</strong> {character.affiliation}</div>
          <div><strong>Occupation:</strong> {character.occupation}</div>
          <div><strong>Birth Date:</strong> {character.birth_date}</div>
          <div><strong>Birth Place:</strong> {character.birth_place}</div>
          <div class="md:col-span-2"><strong>Relatives:</strong> {character.relatives}</div>
          <div><strong>First Appearance:</strong> Chapter {character.first_appearance}</div>
        </div>
      </div>
    </div>
  </div>
</TVLayout>

