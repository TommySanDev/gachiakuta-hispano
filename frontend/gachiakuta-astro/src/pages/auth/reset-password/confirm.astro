---
import HeaderLayout from '../../../layouts/HeaderLayout.astro';

// Dynamic page to handle token validation
export const prerender = false;

// Extract token from URL for validation
const token = Astro.url.searchParams.get('token');

// Redirect if no token provided
if (!token) {
  return Astro.redirect('/auth/reset-password?error=missing-token');
}
---

<HeaderLayout title="Confirm Password Reset - Gachiakuta Hispano">
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-red-800 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      <!-- Page header -->
      <div class="text-center">
        <h1 class="text-3xl font-bold text-white mb-2">
          Create New Password
        </h1>
        <p class="text-gray-300">
          Enter your new password below
        </p>
      </div>

      <!-- Info section -->
      <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-6 shadow-xl border border-gray-600">
        <div class="text-center">
          <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-4">
            <div class="flex items-center">
              <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
              <span>You're resetting your password via a secure email link</span>
            </div>
          </div>
          <p class="text-gray-300 text-sm">
            Create a new password for your account. Make sure it's strong and secure.
          </p>
        </div>
      </div>

      <!-- Password reset form -->
      <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-8 shadow-xl border border-gray-600">
        <form id="reset-form" class="space-y-6">
          <!-- Success message -->
          <div id="reset-success" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
            <div class="flex items-center">
              <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span id="reset-success-message"></span>
            </div>
          </div>

          <!-- Error message -->
          <div id="reset-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
            <div class="flex items-center">
              <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
              <span id="reset-error-message"></span>
            </div>
          </div>

          <!-- New password field -->
          <div>
            <label for="new-password" class="block text-sm font-medium text-white mb-1">
              New Password <span class="text-red-300">*</span>
            </label>
            <input
              id="new-password"
              name="new_password"
              type="password"
              required
              placeholder="Enter your new password"
              class="block w-full px-3 py-2 border border-gray-500 rounded-md bg-white text-gray-900 placeholder-gray-500 focus:border-red-500 focus:ring-red-500 transition-colors duration-200"
            />
            <p class="text-xs text-gray-300 mt-1">Minimum 8 characters</p>
          </div>

          <!-- Confirm password field -->
          <div>
            <label for="confirm-password" class="block text-sm font-medium text-white mb-1">
              Confirm New Password <span class="text-red-300">*</span>
            </label>
            <input
              id="confirm-password"
              name="confirm_password"
              type="password"
              required
              placeholder="Confirm your new password"
              class="block w-full px-3 py-2 border border-gray-500 rounded-md bg-white text-gray-900 placeholder-gray-500 focus:border-red-500 focus:ring-red-500 transition-colors duration-200"
            />
            <div id="password-match-feedback" class="text-xs mt-1 hidden"></div>
          </div>

          <!-- Submit button -->
          <button
            type="submit"
            id="reset-submit"
            class="w-full bg-gray-800 hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-medium py-3 px-4 rounded-md transition-colors duration-200"
          >
            <span id="reset-submit-text">Update Password</span>
          </button>
        </form>

        <!-- Security tips -->
        <div class="mt-6 p-4 bg-gray-800 bg-opacity-50 rounded-lg border border-gray-600">
          <h3 class="text-sm font-medium text-white mb-2">Password Tips:</h3>
          <ul class="text-xs text-gray-300 space-y-1">
            <li>• Use at least 8 characters</li>
            <li>• Include letters, numbers, and symbols</li>
            <li>• Avoid common words or personal info</li>
            <li>• Consider using a password manager</li>
          </ul>
        </div>
      </div>

      <!-- Back to login -->
      <div class="text-center text-sm text-gray-300">
        <a href="/auth/login" class="text-white hover:underline font-medium">
          ← Back to Login
        </a>
      </div>
    </div>
  </div>

  <script define:vars={{ token }}>
    import { apiClient } from '../../../lib/api-client';
    import type { ResetPasswordInput } from '../../../types/auth';

    // Elements
    const form = document.getElementById('reset-form') as HTMLFormElement;
    const newPasswordInput = document.getElementById('new-password') as HTMLInputElement;
    const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement;
    const passwordMatchFeedback = document.getElementById('password-match-feedback') as HTMLDivElement;
    const submitBtn = document.getElementById('reset-submit') as HTMLButtonElement;
    const submitText = document.getElementById('reset-submit-text') as HTMLSpanElement;
    const errorDiv = document.getElementById('reset-error') as HTMLDivElement;
    const errorMessage = document.getElementById('reset-error-message') as HTMLSpanElement;
    const successDiv = document.getElementById('reset-success') as HTMLDivElement;
    const successMessage = document.getElementById('reset-success-message') as HTMLSpanElement;

    // Show error message
    function showError(message: string) {
      errorMessage.textContent = message;
      errorDiv.classList.remove('hidden');
      successDiv.classList.add('hidden');
    }

    // Show success message
    function showSuccess(message: string) {
      successMessage.textContent = message;
      successDiv.classList.remove('hidden');
      errorDiv.classList.add('hidden');
    }

    // Hide all form messages
    function hideFormMessages() {
      errorDiv.classList.add('hidden');
      successDiv.classList.add('hidden');
    }

    // Set loading state
    function setLoading(loading: boolean) {
      submitBtn.disabled = loading;
      submitText.textContent = loading ? 'Updating...' : 'Update Password';
      newPasswordInput.disabled = loading;
      confirmPasswordInput.disabled = loading;
    }

    // Validate password match
    function validatePasswordMatch() {
      const newPassword = newPasswordInput.value;
      const confirmPassword = confirmPasswordInput.value;

      if (confirmPassword === '') {
        passwordMatchFeedback.classList.add('hidden');
        return true;
      }

      if (newPassword === confirmPassword) {
        passwordMatchFeedback.textContent = '✓ Passwords match';
        passwordMatchFeedback.className = 'text-xs mt-1 text-green-400';
        passwordMatchFeedback.classList.remove('hidden');
        return true;
      } else {
        passwordMatchFeedback.textContent = '✗ Passwords do not match';
        passwordMatchFeedback.className = 'text-xs mt-1 text-red-400';
        passwordMatchFeedback.classList.remove('hidden');
        return false;
      }
    }

    // Handle form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideFormMessages();

      const newPassword = newPasswordInput.value;
      const confirmPassword = confirmPasswordInput.value;

      // Validate passwords
      if (newPassword.length < 8) {
        showError('Password must be at least 8 characters long');
        return;
      }

      if (newPassword !== confirmPassword) {
        showError('Passwords do not match');
        return;
      }

      try {
        setLoading(true);

        const resetData: ResetPasswordInput = {
          token: token,
          new_password: newPassword
        };
        
        await apiClient.post('/api/auth/reset-password/confirm', resetData);
        
        showSuccess('Password updated successfully! Redirecting to login...');
        
        // Clear form
        form.reset();
        passwordMatchFeedback.classList.add('hidden');
        
        // Redirect to login after 3 seconds
        setTimeout(() => {
          window.location.href = '/auth/login?message=password-reset-success';
        }, 3000);

      } catch (error) {
        let message = 'Failed to update password';
        
        if (error instanceof Error) {
          // Handle specific error cases
          if (error.message.includes('Invalid') || error.message.includes('expired')) {
            message = 'This reset link is invalid or has expired. Please request a new one.';
          } else {
            message = error.message;
          }
        }
        
        showError(message);
      } finally {
        setLoading(false);
      }
    });

    // Real-time password confirmation validation
    confirmPasswordInput.addEventListener('input', validatePasswordMatch);
    newPasswordInput.addEventListener('input', () => {
      if (confirmPasswordInput.value) {
        validatePasswordMatch();
      }
    });

    // Auto-focus on password field
    newPasswordInput.focus();
  </script>
</HeaderLayout>
