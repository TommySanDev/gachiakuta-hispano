---
import HeaderLayout from '../../layouts/HeaderLayout.astro';

export const prerender = false;

const token = Astro.url.searchParams.get('token');
const email = Astro.url.searchParams.get('email');

if (!token) {
  return Astro.redirect('/auth/login?error=missing-verification-token');
}
---

<HeaderLayout title="Verify Email - Gachiakuta Hispano">
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-red-800 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      <div class="text-center">
        <h1 class="text-3xl font-bold text-white mb-2">
          Verify Your Email
        </h1>
        <p class="text-gray-300">
          We're verifying your email address
        </p>
      </div>

      <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-8 shadow-xl border border-gray-600">
        
        <!-- Loading state -->
        <div id="verification-loading" class="text-center">
          <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-white mx-auto mb-4"></div>
          <p class="text-white text-lg">Verifying your email...</p>
          <p class="text-gray-300 text-sm mt-2">Please wait a moment</p>
        </div>

        <!-- Success state -->
        <div id="verification-success" class="hidden text-center">
          <div class="bg-green-100 rounded-full h-16 w-16 flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h2 class="text-2xl font-semibold text-white mb-2">Email Verified!</h2>
          <p class="text-gray-300 mb-6">
            Your email address has been successfully verified. You can now access all features of your account.
          </p>
          <a 
            href="/auth/login?message=email-verified"
            class="inline-flex items-center px-6 py-3 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-md transition-colors"
          >
            Continue to Login
          </a>
        </div>

        <!-- Error state -->
        <div id="verification-error" class="hidden text-center">
          <div class="bg-red-100 rounded-full h-16 w-16 flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h2 class="text-2xl font-semibold text-white mb-2">Verification Failed</h2>
          <p id="error-message" class="text-gray-300 mb-6">
            The verification link is invalid or has expired.
          </p>
          
          <div class="space-y-3">
            <button
              id="resend-verification-btn"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-md transition-colors"
            >
              <span id="resend-text">Send New Verification Email</span>
            </button>
            
            <a 
              href="/auth/register"
              class="block w-full bg-gray-800 hover:bg-gray-700 text-white font-medium py-3 px-4 rounded-md transition-colors text-center"
            >
              Back to Registration
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</HeaderLayout>

<script>
  import { apiClient } from '../../lib/api-client';

  // Get values from URL (more reliable than define:vars)
  const urlParams = new URLSearchParams(window.location.search);
  const token = urlParams.get('token');
  const email = urlParams.get('email');

  console.log('Verification page loaded', { token: token ? 'exists' : 'missing', email });

  const loadingDiv = document.getElementById('verification-loading');
  const successDiv = document.getElementById('verification-success');
  const errorDiv = document.getElementById('verification-error');
  const errorMessage = document.getElementById('error-message');
  const resendBtn = document.getElementById('resend-verification-btn');
  const resendText = document.getElementById('resend-text');

  function showSuccess() {
    loadingDiv.classList.add('hidden');
    errorDiv.classList.add('hidden');
    successDiv.classList.remove('hidden');
  }

  function showError(message) {
    loadingDiv.classList.add('hidden');
    successDiv.classList.add('hidden');
    errorMessage.textContent = message;
    errorDiv.classList.remove('hidden');
  }

  async function verifyEmail() {
    console.log('Starting verification with token:', token);
    
    if (!token) {
      showError('No verification token found in URL');
      return;
    }

    try {
      console.log('Sending verification request...');
      const response = await apiClient.post('/api/auth/verify-email', { token });
      console.log('Verification successful:', response);
      showSuccess();
    } catch (error) {
      console.error('Verification failed:', error);
      
      let message = 'The verification link is invalid or has expired.';
      
      if (error instanceof Error) {
        if (error.message.includes('already verified')) {
          message = 'This email address is already verified.';
        } else if (error.message.includes('expired')) {
          message = 'The verification link has expired. Please request a new one.';
        }
      }
      
      showError(message);
    }
  }

  resendBtn?.addEventListener('click', async () => {
    if (!email) {
      showError('No email address found. Please try registering again.');
      return;
    }

    try {
      resendBtn.disabled = true;
      resendText.textContent = 'Sending...';

      await apiClient.post('/api/auth/resend-verification', { email });
      alert('New verification email sent! Please check your inbox.');

    } catch (error) {
      const message = error instanceof Error ? error.message : 'Failed to send verification email';
      alert(`Error: ${message}`);
    } finally {
      resendBtn.disabled = false;
      resendText.textContent = 'Send New Verification Email';
    }
  });

  // Start verification
  console.log('About to start verification...');
  verifyEmail();
</script>
