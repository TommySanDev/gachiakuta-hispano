---
import HeaderLayout from '../../layouts/HeaderLayout.astro';

// This page needs access to query params
export const prerender = false;

// Get token from URL
const token = Astro.url.searchParams.get('token');
const isLoginAttempt = !!token;
---

<HeaderLayout title="Magic Link - Gachiakuta Hispano">
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-red-800 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      
      {isLoginAttempt ? (
        <!-- Magic link login attempt -->
        <div class="text-center">
          <h1 class="text-3xl font-bold text-white mb-2">
            Signing you in...
          </h1>
          <p class="text-gray-300">
            Processing your magic link
          </p>
          
          <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-8 shadow-xl border border-gray-600 mt-8">
            <div id="login-status" class="text-center">
              <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-white mx-auto mb-4"></div>
              <p class="text-white">Authenticating...</p>
            </div>
            
            <!-- Success message -->
            <div id="login-success" class="hidden text-center">
              <svg class="h-12 w-12 text-green-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <h3 class="text-lg font-semibold text-white mb-2">Welcome back!</h3>
              <p class="text-gray-300 text-sm">Redirecting you to your dashboard...</p>
            </div>
            
            <!-- Error message -->
            <div id="login-error" class="hidden text-center">
              <svg class="h-12 w-12 text-red-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 15.5C3.312 16.333 4.274 18 5.814 18z" />
              </svg>
              <h3 class="text-lg font-semibold text-white mb-2">Authentication failed</h3>
              <p id="error-message" class="text-gray-300 text-sm mb-4"></p>
              <a href="/auth/login" class="text-blue-400 hover:text-blue-300 underline">
                Try signing in normally
              </a>
            </div>
          </div>
        </div>
      ) : (
        <!-- Request magic link -->
        <div class="text-center">
          <h1 class="text-3xl font-bold text-white mb-2">
            Magic Link Login
          </h1>
          <p class="text-gray-300">
            Sign in without a password using email
          </p>
          
          <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-8 shadow-xl border border-gray-600 mt-8">
            <form id="magic-link-form" class="space-y-6">
              <!-- Success message -->
              <div id="request-success" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
                <div class="flex items-center">
                  <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span id="request-success-message"></span>
                </div>
              </div>

              <!-- Error message -->
              <div id="request-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
                <div class="flex items-center">
                  <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                  <span id="request-error-message"></span>
                </div>
              </div>

              <!-- Email field -->
              <div>
                <label for="email" class="block text-sm font-medium text-white mb-1">
                  Email Address <span class="text-red-300">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="Enter your email"
                  class="block w-full px-3 py-2 border border-gray-500 rounded-md bg-white text-gray-900 placeholder-gray-500 focus:border-red-500 focus:ring-red-500 transition-colors duration-200"
                />
                <p class="text-xs text-gray-300 mt-1">We'll send you a secure login link</p>
              </div>

              <!-- Submit button -->
              <button
                type="submit"
                id="magic-submit"
                class="w-full bg-gray-800 hover:bg-gray-700 disabled:opacity-50 text-white font-medium py-3 px-4 rounded-md transition-colors duration-200"
              >
                <span id="magic-submit-text">Send Magic Link</span>
              </button>
            </form>

            <!-- Back to login -->
            <div class="text-center mt-6">
              <a href="/auth/login" class="text-gray-300 hover:text-white text-sm underline">
                ← Back to password login
              </a>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  <script define:vars={{ token, isLoginAttempt }}>
    document.addEventListener('DOMContentLoaded', function() {
      console.log('✅ Magic link script loaded');
      console.log('🔍 Is login attempt:', isLoginAttempt);
      console.log('🔑 Token:', token ? 'exists' : 'none');

      if (isLoginAttempt) {
        // Handle magic link login
        handleMagicLinkLogin();
      } else {
        // Handle magic link request
        setupMagicLinkRequest();
      }
    });

    async function handleMagicLinkLogin() {
      console.log('🔐 Processing magic link login...');
      
      const statusDiv = document.getElementById('login-status');
      const successDiv = document.getElementById('login-success');
      const errorDiv = document.getElementById('login-error');
      const errorMsg = document.getElementById('error-message');

      try {
        console.log('📤 Calling magic link API...');
        
        const response = await fetch(`http://localhost:8080/api/auth/magic-link?token=${encodeURIComponent(token)}`, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' }
        });

        console.log('📥 Response status:', response.status);

        if (response.ok) {
          const result = await response.json();
          console.log('✅ Login success:', result);
          
          // Store auth data
          if (result.token && result.user) {
            // Set cookies (matching your auth store format)
            document.cookie = `auth_token=${result.token}; path=/; max-age=${result.expires_in || 3600}; SameSite=Lax`;
            document.cookie = `auth_user=${encodeURIComponent(JSON.stringify(result.user))}; path=/; max-age=${result.expires_in || 3600}; SameSite=Lax`;
          }
          
          // Show success
          statusDiv.classList.add('hidden');
          successDiv.classList.remove('hidden');
          
          // Redirect after 2 seconds
          setTimeout(() => {
            window.location.href = '/';
          }, 2000);
          
        } else {
          const error = await response.json().catch(() => ({ error: 'Login failed' }));
          console.log('❌ Login error:', error);
          
          statusDiv.classList.add('hidden');
          errorDiv.classList.remove('hidden');
          errorMsg.textContent = error.error || 'Invalid or expired magic link';
        }
        
      } catch (error) {
        console.error('❌ Network error:', error);
        
        statusDiv.classList.add('hidden');
        errorDiv.classList.remove('hidden');
        errorMsg.textContent = 'Network error: ' + error.message;
      }
    }

    function setupMagicLinkRequest() {
      console.log('📧 Setting up magic link request form');
      
      const form = document.getElementById('magic-link-form');
      const successDiv = document.getElementById('request-success');
      const successMsg = document.getElementById('request-success-message');
      const errorDiv = document.getElementById('request-error');
      const errorMsg = document.getElementById('request-error-message');
      const submitBtn = document.getElementById('magic-submit');
      const submitText = document.getElementById('magic-submit-text');

      if (!form) {
        console.error('❌ Form not found');
        return;
      }

      console.log('✅ Form found, adding listener');

      form.addEventListener('submit', async function(e) {
        console.log('🚀 Magic link request submitted');
        e.preventDefault();

        const email = new FormData(form).get('email');
        console.log('📧 Email:', email);

        if (!email) {
          showError('Email is required');
          return;
        }

        try {
          setLoading(true);
          console.log('📤 Requesting magic link...');
          
          const response = await fetch('http://localhost:8080/api/auth/magic-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
          });

          console.log('📥 Response status:', response.status);

          if (response.ok) {
            const result = await response.json();
            console.log('✅ Request success:', result);
            
            showSuccess('Magic link sent! Check your email and click the link to sign in.');
            form.reset();
          } else {
            const error = await response.json().catch(() => ({ error: 'Request failed' }));
            console.log('❌ Request error:', error);
            showError(error.error || 'Failed to send magic link');
          }
          
        } catch (error) {
          console.error('❌ Network error:', error);
          showError('Network error: ' + error.message);
        } finally {
          setLoading(false);
        }
      });

      function showError(msg) {
        console.log('❌ Error:', msg);
        errorMsg.textContent = msg;
        errorDiv.classList.remove('hidden');
        successDiv.classList.add('hidden');
      }

      function showSuccess(msg) {
        console.log('✅ Success:', msg);
        successMsg.textContent = msg;
        successDiv.classList.remove('hidden');
        errorDiv.classList.add('hidden');
      }

      function setLoading(loading) {
        submitBtn.disabled = loading;
        submitText.textContent = loading ? 'Sending...' : 'Send Magic Link';
      }

      console.log('✅ Magic link request setup complete');
    }
  </script>
</HeaderLayout>
