---
import HeaderLayout from '../../layouts/HeaderLayout.astro';

// This page needs to handle both request and confirmation
export const prerender = false;

// Get token from URL parameters
const url = new URL(Astro.request.url);
const token = url.searchParams.get('token');
const isConfirmation = !!token;
---

<HeaderLayout title="Reset Password - Gachiakuta Hispano">
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-red-800 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      <!-- Page header -->
      <div class="text-center">
        <h1 class="text-3xl font-bold text-white mb-2">
          {isConfirmation ? 'Set New Password' : 'Reset Password'}
        </h1>
        <p class="text-gray-300">
          {isConfirmation 
            ? 'Enter your new password below' 
            : 'Enter your email to receive reset instructions'
          }
        </p>
      </div>

      <!-- Form card -->
      <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-8 shadow-xl border border-gray-600">
        {isConfirmation ? (
          <!-- Password Reset Confirmation Form -->
          <div class="w-full max-w-md mx-auto">
            <form id="reset-confirm-form" class="space-y-6">
              <input type="hidden" name="token" value={token} />
              
              <!-- Error/Success display -->
              <div id="reset-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
                <div class="flex items-center">
                  <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                  <span id="reset-error-message"></span>
                </div>
              </div>

              <div id="reset-success" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
                <div class="flex items-center">
                  <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span id="reset-success-message"></span>
                </div>
              </div>

              <!-- New password field -->
              <div class="space-y-1">
                <label for="new_password" class="block text-sm font-medium text-gray-300">
                  New Password *
                </label>
                <input
                  id="new_password"
                  name="new_password"
                  type="password"
                  required
                  placeholder="Enter your new password"
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                />
                <p class="text-sm text-gray-500">Minimum 8 characters</p>
              </div>

              <!-- Confirm password field -->
              <div class="space-y-1">
                <label for="confirm_password" class="block text-sm font-medium text-gray-300">
                  Confirm Password *
                </label>
                <input
                  id="confirm_password"
                  name="confirm_password"
                  type="password"
                  required
                  placeholder="Confirm your new password"
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                />
              </div>

              <!-- Submit button -->
              <button
                type="submit"
                id="reset-submit"
                class="w-full bg-gray-800 hover:bg-gray-700 text-white font-medium py-3 px-6 rounded-md transition-colors duration-200"
              >
                <span id="reset-submit-text">Update Password</span>
              </button>
            </form>
          </div>
        ) : (
          <!-- Password Reset Request Form -->
          <div class="w-full max-w-md mx-auto">
            <form id="reset-request-form" class="space-y-6">
              <!-- Error/Success display -->
              <div id="request-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
                <div class="flex items-center">
                  <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                  <span id="request-error-message"></span>
                </div>
              </div>

              <div id="request-success" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
                <div class="flex items-center">
                  <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span id="request-success-message"></span>
                </div>
              </div>

              <!-- Email field -->
              <div class="space-y-1">
                <label for="email" class="block text-sm font-medium text-gray-300">
                  Email Address *
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="Enter your email"
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                />
                <p class="text-sm text-gray-500">We'll send you a reset link</p>
              </div>

              <!-- Submit button -->
              <button
                type="submit"
                id="request-submit"
                class="w-full bg-gray-800 hover:bg-gray-700 text-white font-medium py-3 px-6 rounded-md transition-colors duration-200"
              >
                <span id="request-submit-text">Send Reset Link</span>
              </button>
            </form>
          </div>
        )}

        <!-- Back to login link -->
        <div class="text-center mt-6">
          <a href="/auth/login" class="text-gray-300 hover:text-white text-sm underline">
            ← Back to Sign In
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../../lib/api-client';
    import type { ResetPasswordRequestInput, ResetPasswordInput } from '../../types/auth';

    // Get form elements
    const isConfirmation = document.querySelector('input[name="token"]') !== null;

    if (isConfirmation) {
      // Handle password reset confirmation
      const form = document.getElementById('reset-confirm-form') as HTMLFormElement;
      const errorDiv = document.getElementById('reset-error') as HTMLDivElement;
      const errorMessage = document.getElementById('reset-error-message') as HTMLSpanElement;
      const successDiv = document.getElementById('reset-success') as HTMLDivElement;
      const successMessage = document.getElementById('reset-success-message') as HTMLSpanElement;
      const submitBtn = document.getElementById('reset-submit') as HTMLButtonElement;
      const submitText = document.getElementById('reset-submit-text') as HTMLSpanElement;

      function showError(message: string) {
        errorMessage.textContent = message;
        errorDiv.classList.remove('hidden');
        successDiv.classList.add('hidden');
      }

      function showSuccess(message: string) {
        successMessage.textContent = message;
        successDiv.classList.remove('hidden');
        errorDiv.classList.add('hidden');
      }

      function setLoading(loading: boolean) {
        submitBtn.disabled = loading;
        submitText.textContent = loading ? 'Updating...' : 'Update Password';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const newPassword = formData.get('new_password') as string;
        const confirmPassword = formData.get('confirm_password') as string;
        const token = formData.get('token') as string;

        // Validate passwords
        if (newPassword !== confirmPassword) {
          showError('Passwords do not match');
          return;
        }
        if (newPassword.length < 8) {
          showError('Password must be at least 8 characters');
          return;
        }

        try {
          setLoading(true);
          
          const resetData: ResetPasswordInput = {
            token: token,
            new_password: newPassword
          };

          await apiClient.post('/api/auth/reset-password/confirm', resetData);
          
          showSuccess('Password updated successfully! Redirecting to login...');
          
          setTimeout(() => {
            window.location.href = '/auth/login?message=password-reset-success';
          }, 2000);

        } catch (error) {
          const message = error instanceof Error ? error.message : 'Failed to reset password';
          showError(message);
        } finally {
          setLoading(false);
        }
      });

    } else {
      // Handle password reset request
      const form = document.getElementById('reset-request-form') as HTMLFormElement;
      const errorDiv = document.getElementById('request-error') as HTMLDivElement;
      const errorMessage = document.getElementById('request-error-message') as HTMLSpanElement;
      const successDiv = document.getElementById('request-success') as HTMLDivElement;
      const successMessage = document.getElementById('request-success-message') as HTMLSpanElement;
      const submitBtn = document.getElementById('request-submit') as HTMLButtonElement;
      const submitText = document.getElementById('request-submit-text') as HTMLSpanElement;

      function showError(message: string) {
        errorMessage.textContent = message;
        errorDiv.classList.remove('hidden');
        successDiv.classList.add('hidden');
      }

      function showSuccess(message: string) {
        successMessage.textContent = message;
        successDiv.classList.remove('hidden');
        errorDiv.classList.add('hidden');
      }

      function setLoading(loading: boolean) {
        submitBtn.disabled = loading;
        submitText.textContent = loading ? 'Sending...' : 'Send Reset Link';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const requestData: ResetPasswordRequestInput = {
          email: formData.get('email') as string
        };

        if (!requestData.email) {
          showError('Email is required');
          return;
        }

        try {
          setLoading(true);
          
          await apiClient.post('/api/auth/reset-password', requestData);
          
          showSuccess('If your email exists, you will receive reset instructions shortly.');
          form.reset();

        } catch (error) {
          const message = error instanceof Error ? error.message : 'Failed to send reset link';
          showError(message);
        } finally {
          setLoading(false);
        }
      });
    }
  </script>
</HeaderLayout>
