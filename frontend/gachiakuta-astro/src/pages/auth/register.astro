---
import HeaderLayout from '../../layouts/HeaderLayout.astro';
import RegisterForm from '../../components/auth/RegisterForm.astro';

// This page needs access to request headers for middleware
export const prerender = false;
---

<HeaderLayout title="Sign Up - Gachiakuta Hispano">
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-red-800 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      <!-- Page header -->
      <div class="text-center">
        <h1 class="text-3xl font-bold text-white mb-2">
          Join Gachiakuta Hispano
        </h1>
        <p class="text-gray-300">
          Create your account to start exploring the world of Gachiakuta
        </p>
      </div>

      <!-- Register form card -->
      <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-8 shadow-xl border border-gray-600">
        <RegisterForm />
      </div>

      <!-- Additional info -->
      <div class="text-center text-sm text-gray-300">
        <p>
          Already have an account? 
          <a href="/auth/login" class="text-white hover:underline font-medium">
            Sign in here
          </a>
        </p>
      </div>
    </div>
  </div>
</HeaderLayout>
