---
import HeaderLayout from '../../layouts/HeaderLayout.astro';
import { getUserFromCookies } from '../../lib/auth-server';

// This page requires authentication
export const prerender = false;

// Server-side authentication check
const user = await getUserFromCookies(Astro.cookies);

// Redirect if not authenticated
if (!user) {
  return Astro.redirect('/auth/login?returnTo=/auth/profile');
}
---

<HeaderLayout title="Profile - Gachiakuta Hispano">
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-red-800 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-8">
      <!-- Page header -->
      <div class="text-center">
        <h1 class="text-3xl font-bold text-white mb-2">
          My Profile
        </h1>
        <p class="text-gray-300">
          Manage your account settings and preferences
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- User Info Card -->
        <div class="lg:col-span-1">
          <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-6 shadow-xl border border-gray-600">
            <div class="text-center">
              <!-- User avatar -->
              <div class="mx-auto h-24 w-24 rounded-full bg-gray-600 flex items-center justify-center mb-4">
                <span class="text-2xl font-semibold text-white uppercase">
                  {user.first_name.charAt(0)}{user.last_name.charAt(0)}
                </span>
              </div>
              
              <h2 class="text-xl font-semibold text-white">
                {user.first_name} {user.last_name}
              </h2>
              <p class="text-gray-300 mb-4">@{user.username}</p>
              
              <!-- Role badge -->
              <div class="flex justify-center">
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${
                  user.role === 'admin' 
                    ? 'bg-red-100 text-red-800' 
                    : user.role === 'editor' 
                    ? 'bg-blue-100 text-blue-800' 
                    : 'bg-gray-100 text-gray-800'
                }`}>
                  {user.role.charAt(0).toUpperCase() + user.role.slice(1)}
                </span>
              </div>

              <!-- Account status -->
              <div class="mt-4 space-y-2 text-sm">
                <div class="flex justify-between text-gray-300">
                  <span>Email verified:</span>
                  <span class={user.email_verified ? 'text-green-400' : 'text-yellow-400'}>
                    {user.email_verified ? 'Yes' : 'Pending'}
                  </span>
                </div>
                <div class="flex justify-between text-gray-300">
                  <span>2FA enabled:</span>
                  <span class={user.totp_enabled ? 'text-green-400' : 'text-gray-400'}>
                    {user.totp_enabled ? 'Yes' : 'No'}
                  </span>
                </div>
                <div class="flex justify-between text-gray-300">
                  <span>Magic link:</span>
                  <span class={user.magic_link_enabled ? 'text-green-400' : 'text-gray-400'}>
                    {user.magic_link_enabled ? 'Enabled' : 'Disabled'}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Profile Forms -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Profile Information -->
          <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-6 shadow-xl border border-gray-600">
            <h3 class="text-lg font-semibold text-white mb-4">Profile Information</h3>
            
            <!-- Success/Error Messages -->
            <div id="profile-success" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
              <div class="flex items-center">
                <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span id="profile-success-message"></span>
              </div>
            </div>

            <div id="profile-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
              <div class="flex items-center">
                <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span id="profile-error-message"></span>
              </div>
            </div>

            <!-- Read-only view -->
            <div id="profile-view" class="space-y-4">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-300 mb-1">First Name</label>
                  <input 
                    type="text" 
                    value={user.first_name}
                    class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                    readonly
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-300 mb-1">Last Name</label>
                  <input 
                    type="text" 
                    value={user.last_name}
                    class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                    readonly
                  />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">Username</label>
                <input 
                  type="text" 
                  value={user.username}
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                  readonly
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">Email</label>
                <input 
                  type="email" 
                  value={user.email}
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                  readonly
                />
                <p class="text-xs text-gray-400 mt-1">Email cannot be changed</p>
              </div>
              <button 
                id="edit-profile-btn"
                class="bg-gray-800 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded-md transition-colors"
              >
                Edit Profile
              </button>
            </div>

            <!-- Edit form (hidden by default) -->
            <form id="profile-edit-form" class="hidden space-y-4">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-300 mb-1">First Name</label>
                  <input 
                    id="edit-first-name"
                    name="first_name"
                    type="text" 
                    value={user.first_name}
                    class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                    required
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-300 mb-1">Last Name</label>
                  <input 
                    id="edit-last-name"
                    name="last_name"
                    type="text" 
                    value={user.last_name}
                    class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                    required
                  />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">Username</label>
                <input 
                  id="edit-username"
                  name="username"
                  type="text" 
                  value={user.username}
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                  required
                />
                <p class="text-xs text-gray-400 mt-1">Username must be unique</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">Email</label>
                <input 
                  type="email" 
                  value={user.email}
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-700 text-gray-400 placeholder-gray-400"
                  readonly
                  disabled
                />
                <p class="text-xs text-gray-400 mt-1">Email cannot be changed for security reasons</p>
              </div>
              
              <div class="flex items-center space-x-4 pt-4">
                <button 
                  type="submit"
                  id="save-profile-btn"
                  class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-6 rounded-md transition-colors"
                >
                  <span id="save-profile-text">Save Changes</span>
                </button>
                <button 
                  type="button"
                  id="cancel-edit-btn"
                  class="bg-gray-600 hover:bg-gray-500 text-white font-medium py-2 px-4 rounded-md transition-colors"
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>

          <!-- Change Password -->
          <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-6 shadow-xl border border-gray-600">
            <h3 class="text-lg font-semibold text-white mb-4">Change Password</h3>
            
            <!-- Success/Error Messages for Password -->
            <div id="password-success" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
              <div class="flex items-center">
                <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span id="password-success-message"></span>
              </div>
            </div>

            <div id="password-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
              <div class="flex items-center">
                <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span id="password-error-message"></span>
              </div>
            </div>

            <!-- Password view (default) -->
            <div id="password-view">
              <p class="text-gray-300 text-sm mb-4">
                Update your password to keep your account secure.
              </p>
              <button 
                id="change-password-btn"
                class="bg-gray-800 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded-md transition-colors"
              >
                Change Password
              </button>
            </div>

            <!-- Password change form (hidden by default) -->
            <form id="password-change-form" class="hidden space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">
                  Current Password <span class="text-red-400">*</span>
                </label>
                <input 
                  name="current_password"
                  type="password"
                  required
                  placeholder="Enter your current password"
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">
                  New Password <span class="text-red-400">*</span>
                </label>
                <input 
                  id="new-password-input"
                  name="new_password"
                  type="password"
                  required
                  placeholder="Enter your new password"
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                />
                <p class="text-xs text-gray-400 mt-1">Minimum 8 characters</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">
                  Confirm New Password <span class="text-red-400">*</span>
                </label>
                <input 
                  id="confirm-password-input"
                  name="confirm_password"
                  type="password"
                  required
                  placeholder="Confirm your new password"
                  class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
                />
              </div>

              <div class="flex items-center space-x-4 pt-4">
                <button 
                  type="submit"
                  id="save-password-btn"
                  class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-6 rounded-md transition-colors"
                >
                  <span id="save-password-text">Update Password</span>
                </button>
                <button 
                  type="button"
                  id="cancel-password-btn"
                  class="bg-gray-600 hover:bg-gray-500 text-white font-medium py-2 px-4 rounded-md transition-colors"
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>

          <!-- Security Settings -->
          <div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-6 shadow-xl border border-gray-600">
            <h3 class="text-lg font-semibold text-white mb-4">Security Settings</h3>
            <div class="space-y-6">
              
              <!-- 2FA Section -->
              <div class="border border-gray-600 rounded-lg p-4">
                <div class="flex items-center justify-between mb-4">
                  <div>
                    <h4 class="text-white font-medium">Two-Factor Authentication</h4>
                    <p class="text-gray-300 text-sm">Add an extra layer of security to your account</p>
                  </div>
                  <div class={`px-3 py-1 rounded-full text-sm font-medium ${
                    user.totp_enabled 
                      ? 'bg-green-100 text-green-800' 
                      : 'bg-gray-100 text-gray-800'
                  }`}>
                    {user.totp_enabled ? 'Enabled' : 'Disabled'}
                  </div>
                </div>

                {!user.totp_enabled ? (
                  <!-- Enable 2FA -->
                  <div class="flex items-center justify-between">
                    <p class="text-gray-300 text-sm">
                      🔒 Protect your account with 2FA
                    </p>
                    <a 
                      href="/auth/2fa-setup"
                      class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-md transition-colors"
                    >
                      Enable 2FA
                    </a>
                  </div>
                ) : (
                  <!-- 2FA Management -->
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <p class="text-gray-300 text-sm">
                        ✅ Your account is protected with 2FA
                      </p>
                    </div>
                    
                    <div class="flex flex-wrap gap-2">
                      <button 
                        id="generate-recovery-codes-btn"
                        class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors text-sm"
                      >
                        🔄 Generate New Recovery Codes
                      </button>
                      
                      <button 
                        id="disable-2fa-btn"
                        class="bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded-md transition-colors text-sm"
                      >
                        ❌ Disable 2FA
                      </button>
                    </div>

                    <!-- Status messages -->
                    <div id="2fa-message" class="hidden mt-3"></div>
                  </div>
                )}
              </div>

              <!-- Magic Link Section -->
              <div class="border border-gray-600 rounded-lg p-4">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="text-white font-medium">Magic Link Login</h4>
                    <p class="text-gray-300 text-sm">Sign in without a password using email links</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input 
                      type="checkbox" 
                      checked={user.magic_link_enabled}
                      class="sr-only peer"
                      id="magic-link-toggle"
                    />
                    <div class="w-11 h-6 bg-gray-600 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-red-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-600"></div>
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</HeaderLayout>

<script>
  import { apiClient } from '../../lib/api-client';
  import { authToken, updateUser } from '../../lib/auth-store';

  // Elements
  const editProfileBtn = document.getElementById('edit-profile-btn');
  const changePasswordBtn = document.getElementById('change-password-btn');
  const generateRecoveryCodesBtn = document.getElementById('generate-recovery-codes-btn');
  const disable2faBtn = document.getElementById('disable-2fa-btn');
  // Password change elements
  const passwordView = document.getElementById('password-view');
  const passwordChangeForm = document.getElementById('password-change-form');
  const cancelPasswordBtn = document.getElementById('cancel-password-btn');
  const savePasswordBtn = document.getElementById('save-password-btn');
  const savePasswordText = document.getElementById('save-password-text');
  const passwordSuccessDiv = document.getElementById('password-success');
  const passwordSuccessMessage = document.getElementById('password-success-message');
  const passwordErrorDiv = document.getElementById('password-error');
  const passwordErrorMessage = document.getElementById('password-error-message');

  // Show password messages
  function showPasswordSuccess(message: string) {
    passwordSuccessMessage.textContent = message;
    passwordSuccessDiv.classList.remove('hidden');
    passwordErrorDiv.classList.add('hidden');
  }

  function showPasswordError(message: string) {
    passwordErrorMessage.textContent = message;
    passwordErrorDiv.classList.remove('hidden');
    passwordSuccessDiv.classList.add('hidden');
  }

  function hidePasswordMessages() {
    passwordSuccessDiv.classList.add('hidden');
    passwordErrorDiv.classList.add('hidden');
  }

  // Toggle password edit mode
  function togglePasswordEditMode(editing: boolean) {
    if (editing) {
      passwordView.classList.add('hidden');
      passwordChangeForm.classList.remove('hidden');
    } else {
      passwordView.classList.remove('hidden');
      passwordChangeForm.classList.add('hidden');
      hidePasswordMessages();
    }
  }

  // Set loading state for password button
  function setPasswordLoading(loading: boolean) {
    savePasswordBtn.disabled = loading;
    savePasswordText.textContent = loading ? 'Updating...' : 'Update Password';
  }

  // Profile edit elements
  const profileView = document.getElementById('profile-view');
  const profileEditForm = document.getElementById('profile-edit-form');
  const cancelEditBtn = document.getElementById('cancel-edit-btn');
  const saveProfileBtn = document.getElementById('save-profile-btn');
  const saveProfileText = document.getElementById('save-profile-text');
  const profileSuccessDiv = document.getElementById('profile-success');
  const profileSuccessMessage = document.getElementById('profile-success-message');
  const profileErrorDiv = document.getElementById('profile-error');
  const profileErrorMessage = document.getElementById('profile-error-message');

  // Show message (success or error)
  function showMessage(message: string, isError: boolean = false) {
    if (messageDiv) {
      messageDiv.className = `mt-3 px-4 py-3 rounded ${
        isError 
          ? 'bg-red-100 border border-red-400 text-red-700' 
          : 'bg-green-100 border border-green-400 text-green-700'
      }`;
      messageDiv.textContent = message;
      messageDiv.classList.remove('hidden');
      
      // Auto-hide after 5 seconds
      setTimeout(() => {
        messageDiv.classList.add('hidden');
      }, 5000);
    }
  }

  // Show profile messages
  function showProfileSuccess(message: string) {
    profileSuccessMessage.textContent = message;
    profileSuccessDiv.classList.remove('hidden');
    profileErrorDiv.classList.add('hidden');
  }

  function showProfileError(message: string) {
    profileErrorMessage.textContent = message;
    profileErrorDiv.classList.remove('hidden');
    profileSuccessDiv.classList.add('hidden');
  }

  const messageDiv = document.getElementById('2fa-message');

  // Show password messages
  function showPasswordSuccess(message: string) {
    passwordSuccessMessage.textContent = message;
    passwordSuccessDiv.classList.remove('hidden');
    passwordErrorDiv.classList.add('hidden');
  }

  function showPasswordError(message: string) {
    passwordErrorMessage.textContent = message;
    passwordErrorDiv.classList.remove('hidden');
    passwordSuccessDiv.classList.add('hidden');
  }

  function hidePasswordMessages() {
    passwordSuccessDiv.classList.add('hidden');
    passwordErrorDiv.classList.add('hidden');
  }

  // Toggle password edit mode
  function togglePasswordEditMode(editing: boolean) {
    if (editing) {
      passwordView.classList.add('hidden');
      passwordChangeForm.classList.remove('hidden');
    } else {
      passwordView.classList.remove('hidden');
      passwordChangeForm.classList.add('hidden');
      hidePasswordMessages();
    }
  }

  // Set loading state for password button
  function hideProfileMessages() {
    profileSuccessDiv.classList.add('hidden');
    profileErrorDiv.classList.add('hidden');
  }

  // Toggle edit mode
  function toggleEditMode(editing: boolean) {
    if (editing) {
      profileView.classList.add('hidden');
      profileEditForm.classList.remove('hidden');
    } else {
      profileView.classList.remove('hidden');
      profileEditForm.classList.add('hidden');
      hideProfileMessages();
    }
  }

  // Set loading state for save button
  function setSaveLoading(loading: boolean) {
    saveProfileBtn.disabled = loading;
    saveProfileText.textContent = loading ? 'Saving...' : 'Save Changes';
  }

  // Edit profile handler
  editProfileBtn?.addEventListener('click', () => {
    toggleEditMode(true);
  });

  // Cancel edit handler
  cancelEditBtn?.addEventListener('click', () => {
    toggleEditMode(false);
    // Reset form values
    profileEditForm.reset();
  });

  // Save profile handler
  profileEditForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideProfileMessages();

    const token = authToken.value;
    if (!token) {
      showProfileError('Authentication required');
      return;
    }

    const formData = new FormData(profileEditForm);
    const updateData = {
      first_name: formData.get('first_name') as string,
      last_name: formData.get('last_name') as string,
      username: formData.get('username') as string,
      magic_link_enabled: undefined // This is handled separately
    };

    // Basic validation
    if (!updateData.first_name || !updateData.last_name || !updateData.username) {
      showProfileError('All fields are required');
      return;
    }

    if (updateData.username.length < 3) {
      showProfileError('Username must be at least 3 characters');
      return;
    }

    try {
      setSaveLoading(true);

      console.log('Updating profile:', updateData);

      const response = await fetch('http://localhost:8080/api/users/me', {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(updateData)
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        throw new Error(errorData.error || `HTTP ${response.status}`);
      }

      const updatedUser = await response.json();
      console.log('Profile updated successfully:', updatedUser);

      // Update local state
      updateUser(updatedUser);

      // Update the readonly view
      const readonlyInputs = profileView.querySelectorAll('input');
      readonlyInputs[0].value = updatedUser.first_name; // First name
      readonlyInputs[1].value = updatedUser.last_name;  // Last name
      readonlyInputs[2].value = updatedUser.username;   // Username

      showProfileSuccess('Profile updated successfully!');
      
      // Switch back to view mode after 2 seconds
      setTimeout(() => {
        toggleEditMode(false);
      }, 2000);

    } catch (error) {
      console.error('Profile update error:', error);
      showProfileError(error instanceof Error ? error.message : 'Failed to update profile');
    } finally {
      setSaveLoading(false);
    }
  });

  // Real-time validation for username
  const usernameInput = document.getElementById('edit-username') as HTMLInputElement;
  usernameInput?.addEventListener('input', () => {
    const value = usernameInput.value;
    if (value.length > 0 && value.length < 3) {
      usernameInput.setCustomValidity('Username must be at least 3 characters');
    } else if (!/^[a-zA-Z0-9_-]+$/.test(value) && value.length > 0) {
      usernameInput.setCustomValidity('Username can only contain letters, numbers, underscores, and hyphens');
    } else {
      usernameInput.setCustomValidity('');
    }
  });

  // Auto-download function for recovery codes
  function downloadRecoveryCodes(codes: string[]) {
    const content = `Gachiakuta Hispano - Nuevos Códigos de Recuperación 2FA

⚠️  IMPORTANTE: Guarde estos códigos en un lugar seguro
🔑 Cada código se puede usar solo una vez
📱 Los necesitará si pierde acceso a su teléfono

Códigos de Recuperación:
${codes.map((code, index) => `${index + 1}. ${code}`).join('\n')}

Fecha de generación: ${new Date().toLocaleString()}

NOTA: Estos códigos reemplazan a los anteriores.`;

    const blob = new Blob([content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'gachiakuta-recovery-codes-new.txt';
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // Change password handler
  changePasswordBtn?.addEventListener('click', () => {
    togglePasswordEditMode(true);
  });

  // Cancel password change handler
  cancelPasswordBtn?.addEventListener('click', () => {
    togglePasswordEditMode(false);
    passwordChangeForm.reset();
  });

  // Save password handler
  passwordChangeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hidePasswordMessages();

    const token = authToken.value;
    if (!token) {
      showPasswordError('Authentication required');
      return;
    }

    const formData = new FormData(passwordChangeForm);
    const currentPassword = formData.get('current_password') as string;
    const newPassword = formData.get('new_password') as string;
    const confirmPassword = formData.get('confirm_password') as string;

    // Basic validation
    if (!currentPassword || !newPassword || !confirmPassword) {
      showPasswordError('All fields are required');
      return;
    }

    if (newPassword.length < 8) {
      showPasswordError('New password must be at least 8 characters');
      return;
    }

    if (newPassword !== confirmPassword) {
      showPasswordError('New passwords do not match');
      return;
    }

    if (currentPassword === newPassword) {
      showPasswordError('New password must be different from current password');
      return;
    }

    try {
      setPasswordLoading(true);

      const passwordData = {
        current_password: currentPassword,
        new_password: newPassword
      };

      console.log('Changing password...');

      const response = await fetch('http://localhost:8080/api/users/me/change-password', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(passwordData)
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        throw new Error(errorData.error || `HTTP ${response.status}`);
      }

      console.log('Password changed successfully');

      showPasswordSuccess('Password updated successfully!');
      
      // Clear form and switch back to view mode after 2 seconds
      passwordChangeForm.reset();
      setTimeout(() => {
        togglePasswordEditMode(false);
      }, 2000);

    } catch (error) {
      console.error('Password change error:', error);
      showPasswordError(error instanceof Error ? error.message : 'Failed to update password');
    } finally {
      setPasswordLoading(false);
    }
  });

  // Real-time password validation
  const newPasswordInput = document.getElementById('new-password-input') as HTMLInputElement;
  const confirmPasswordInput = document.getElementById('confirm-password-input') as HTMLInputElement;

  newPasswordInput?.addEventListener('input', () => {
    const value = newPasswordInput.value;
    if (value.length > 0 && value.length < 8) {
      newPasswordInput.setCustomValidity('Password must be at least 8 characters');
    } else {
      newPasswordInput.setCustomValidity('');
    }
    
    // Also check confirm password if it has a value
    if (confirmPasswordInput.value && confirmPasswordInput.value !== value) {
      confirmPasswordInput.setCustomValidity('Passwords do not match');
    } else if (confirmPasswordInput.value) {
      confirmPasswordInput.setCustomValidity('');
    }
  });

  confirmPasswordInput?.addEventListener('input', () => {
    const newPassword = newPasswordInput.value;
    const confirmPassword = confirmPasswordInput.value;
    
    if (confirmPassword && newPassword !== confirmPassword) {
      confirmPasswordInput.setCustomValidity('Passwords do not match');
    } else {
      confirmPasswordInput.setCustomValidity('');
    }
  });

  // Generate new recovery codes
  generateRecoveryCodesBtn?.addEventListener('click', async () => {
    const token = authToken.value;
    if (!token) {
      showMessage('Authentication required', true);
      return;
    }

    if (!confirm('¿Está seguro? Esto invalidará todos sus códigos de recuperación actuales y generará nuevos.')) {
      return;
    }

    try {
      generateRecoveryCodesBtn.disabled = true;
      generateRecoveryCodesBtn.textContent = 'Generating...';

      const response = await apiClient.post('/api/2fa/recovery-codes', {}, token);
      
      if (response.recovery_codes) {
        downloadRecoveryCodes(response.recovery_codes);
        showMessage(`✅ ${response.recovery_codes.length} nuevos códigos generados y descargados`);
      } else {
        showMessage('Códigos generados exitosamente');
      }

    } catch (error) {
      const message = error instanceof Error ? error.message : 'Error generating recovery codes';
      showMessage(message, true);
    } finally {
      generateRecoveryCodesBtn.disabled = false;
      generateRecoveryCodesBtn.textContent = '🔄 Generate New Recovery Codes';
    }
  });

  // Disable 2FA
  disable2faBtn?.addEventListener('click', async () => {
    const token = authToken.value;
    if (!token) {
      showMessage('Authentication required', true);
      return;
    }

    if (!confirm('¿Está seguro que desea DESHABILITAR la autenticación de dos factores?\n\nEsto hará su cuenta menos segura.')) {
      return;
    }

    try {
      disable2faBtn.disabled = true;
      disable2faBtn.textContent = 'Disabling...';

      await apiClient.delete('/api/2fa/disable', token);
      
      // Update user state
      updateUser({ totp_enabled: false });
      
      showMessage('✅ 2FA deshabilitado exitosamente');
      
      // Reload page after 2 seconds to update UI
      setTimeout(() => {
        window.location.reload();
      }, 2000);

    } catch (error) {
      const message = error instanceof Error ? error.message : 'Error disabling 2FA';
      showMessage(message, true);
    } finally {
      disable2faBtn.disabled = false;
      disable2faBtn.textContent = '❌ Disable 2FA';
    }
  });

  // Magic Link toggle handler
  const magicLinkToggle = document.getElementById('magic-link-toggle') as HTMLInputElement;

  magicLinkToggle?.addEventListener('change', async () => {
    const token = authToken.value;
    if (!token) {
      showMessage('Authentication required', true);
      // Revert toggle
      magicLinkToggle.checked = !magicLinkToggle.checked;
      return;
    }

    const newValue = magicLinkToggle.checked;
    
    try {
      // Update via API
      const updateData = {
        magic_link_enabled: newValue
      };
      
      const updatedUser = await apiClient.put('/api/users/me', updateData, token);
      
      // Update local state
      updateUser({ magic_link_enabled: newValue });
      
      showMessage(
        newValue 
          ? '✅ Magic link login enabled' 
          : '❌ Magic link login disabled'
      );

    } catch (error) {
      const message = error instanceof Error ? error.message : 'Failed to update magic link setting';
      showMessage(message, true);
      
      // Revert toggle on error
      magicLinkToggle.checked = !newValue;
    }
  });

</script>
