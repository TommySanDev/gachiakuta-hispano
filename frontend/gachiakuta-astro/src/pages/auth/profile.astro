---
import HeaderLayout from '../../layouts/HeaderLayout.astro';
import { getUserFromCookies } from '../../lib/auth-server';

// Components
import ProfileHeader from '../../components/profile/ProfileHeader.astro';
import ProfileInformation from '../../components/profile/ProfileInformation.astro';
import ChangePassword from '../../components/profile/ChangePassword.astro';
import SecuritySettings from '../../components/profile/SecuritySettings.astro';

// This page requires authentication
export const prerender = false;

// Server-side authentication check
const user = await getUserFromCookies(Astro.cookies);

// Redirect if not authenticated
if (!user) {
  return Astro.redirect('/auth/login?returnTo=/auth/profile');
}
---

<HeaderLayout title="Profile - Gachiakuta Hispano">
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-red-800 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-8">
      <!-- Page header -->
      <div class="text-center">
        <h1 class="text-3xl font-bold text-white mb-2">
          My Profile
        </h1>
        <p class="text-gray-300">
          Manage your account settings and preferences
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- User Info Card -->
        <div class="lg:col-span-1">
          <ProfileHeader user={user} />
        </div>

        <!-- Profile Forms -->
        <div class="lg:col-span-2 space-y-6">
          <ProfileInformation user={user} />
          <ChangePassword />
          <SecuritySettings user={user} />
        </div>
      </div>
    </div>
  </div>

  <!-- Initialize profile store -->
  <script>
    import { initializeProfileStore } from '../../lib/profile/profile-store';
    import { initializeAuth } from '../../lib/auth-store';
    
    // Initialize stores
    initializeAuth();
    initializeProfileStore();
  </script>
</HeaderLayout>
