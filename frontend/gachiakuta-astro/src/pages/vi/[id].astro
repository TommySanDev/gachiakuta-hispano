---
import TVLayout from '../../layouts/TVLayout.astro';
import { getVitalInstrumentById, getAllVitalInstruments } from '../../lib/vi-api';
import { getCharacterById } from '../../lib/character-api';
import { imageMap } from '../../lib/image-map';
import { Image } from 'astro:assets';

const { params } = Astro;
const id = params.id;

let vi;
let owner = null;

try {
  vi = await getVitalInstrumentById(id);

  if (vi.character_id) {
    try {
      owner = await getCharacterById(String(vi.character_id));
    } catch (err) {
      console.warn(`Character ${vi.character_id} not found for VI ${vi.id}`);
    }
  }
} catch (err) {
  throw new Error(`Vital Instrument with id ${id} not found.`);
}

const imageFilename = vi.main_image.split('/').pop();
const image = imageFilename ? imageMap[imageFilename] : undefined;

export async function getStaticPaths() {
  const allVIs = await getAllVitalInstruments();

  return allVIs.map((vi) => ({
    params: { id: String(vi.id) }
  }));
}
---

<TVLayout title={`${vi.name} - Gachiakuta Hispano`}>
  <div class="min-h-screen bg-gradient-to-br from-red-900 to-black text-white py-16 px-8 max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="flex-shrink-0 w-full md:w-[260px]">
        {image && (
          <Image
            src={image}
            alt={vi.name}
            width={360}
            height={240}
            layout="fixed"
            fit="cover"
            position="center"
            class="rounded shadow-lg"
          />
        )}
      </div>

      <div class="flex-1 space-y-4">
        <h1 class="text-4xl font-bold">{vi.name}</h1>
        <p class="mt-6 text-lg leading-relaxed">{vi.description}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6 text-sm">
          <div><strong>Powers:</strong> {vi.powers}</div>
          {owner && <div><strong>Owner:</strong> <a href={`/characters/${owner.id}`} class="underline text-red-300 hover:text-red-100">{owner.name}</a></div>}
          <div><strong>First Appearance:</strong> Chapter {vi.first_appearance}</div>
        </div>
      </div>
    </div>
  </div>
</TVLayout>

