// === ADMIN DISABLE 2FA FUNCTIONALITY ===

let disable2FAModal = null;
let currentUserForDisable2FA = null;

// Initialize modal elements
function initializeDisable2FAModal() {
  disable2FAModal = {
    container: document.getElementById('disable-2fa-modal'),
    loading: document.getElementById('disable-2fa-loading'),
    confirm: document.getElementById('disable-2fa-confirm'),
    success: document.getElementById('disable-2fa-success'),
    error: document.getElementById('disable-2fa-error'),
    errorMessage: document.getElementById('disable-2fa-error-message'),
    
    // User info elements
    userInitials: document.getElementById('disable-2fa-user-initials'),
    userName: document.getElementById('disable-2fa-user-name'),
    userEmail: document.getElementById('disable-2fa-user-email'),
    
    // Form elements
    confirmCheckbox: document.getElementById('disable-2fa-confirm-checkbox'),
    confirmButton: document.getElementById('confirm-disable-2fa'),
    buttonText: document.getElementById('disable-2fa-button-text'),
    
    // Control buttons
    closeBtn: document.getElementById('close-disable-2fa-modal'),
    cancelBtn: document.getElementById('cancel-disable-2fa'),
    successCloseBtn: document.getElementById('close-disable-2fa-success')
  };

  // Event listeners
  disable2FAModal.closeBtn?.addEventListener('click', hideDisable2FAModal);
  disable2FAModal.cancelBtn?.addEventListener('click', hideDisable2FAModal);
  disable2FAModal.successCloseBtn?.addEventListener('click', hideDisable2FAModal);
  
  // Checkbox validation
  disable2FAModal.confirmCheckbox?.addEventListener('change', () => {
    const isChecked = disable2FAModal.confirmCheckbox.checked;
    disable2FAModal.confirmButton.disabled = !isChecked;
  });

  // Confirm disable action
  disable2FAModal.confirmButton?.addEventListener('click', handleDisable2FA);

  // Close modal when clicking outside
  disable2FAModal.container?.addEventListener('click', (e) => {
    if (e.target === disable2FAModal.container) {
      hideDisable2FAModal();
    }
  });
}

// Show disable 2FA modal
function showDisable2FAModal(user) {
  if (!disable2FAModal) {
    initializeDisable2FAModal();
  }

  currentUserForDisable2FA = user;

  // Populate user info
  disable2FAModal.userInitials.textContent = 
    user.first_name.charAt(0) + user.last_name.charAt(0);
  disable2FAModal.userName.textContent = 
    `${user.first_name} ${user.last_name}`;
  disable2FAModal.userEmail.textContent = user.email;

  // Reset form state
  disable2FAModal.confirmCheckbox.checked = false;
  disable2FAModal.confirmButton.disabled = true;
  hideDisable2FAError();

  // Show modal
  showDisable2FAState('confirm');
  disable2FAModal.container.classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

// Hide disable 2FA modal
function hideDisable2FAModal() {
  disable2FAModal?.container?.classList.add('hidden');
  document.body.style.overflow = '';
  currentUserForDisable2FA = null;
}

// Show different states
function showDisable2FAState(state) {
  if (!disable2FAModal) return;

  // Hide all states
  disable2FAModal.loading?.classList.add('hidden');
  disable2FAModal.confirm?.classList.add('hidden');
  disable2FAModal.success?.classList.add('hidden');

  // Show requested state
  switch (state) {
    case 'loading':
      disable2FAModal.loading?.classList.remove('hidden');
      break;
    case 'confirm':
      disable2FAModal.confirm?.classList.remove('hidden');
      break;
    case 'success':
      disable2FAModal.success?.classList.remove('hidden');
      break;
  }
}

// Show error message
function showDisable2FAError(message) {
  if (disable2FAModal?.error && disable2FAModal?.errorMessage) {
    disable2FAModal.errorMessage.textContent = message;
    disable2FAModal.error.classList.remove('hidden');
  }
}

// Hide error message
function hideDisable2FAError() {
  disable2FAModal?.error?.classList.add('hidden');
}

// Handle disable 2FA action
async function handleDisable2FA() {
  if (!currentUserForDisable2FA) return;

  try {
    hideDisable2FAError();
    showDisable2FAState('loading');

    // Get token
    const token = document.cookie
      .split('; ')
      .find(row => row.startsWith('auth_token='))
      ?.split('=')[1];

    if (!token) {
      throw new Error('Authentication required');
    }

    console.log('Disabling 2FA for user:', currentUserForDisable2FA.id);

    const response = await fetch(`http://localhost:8080/api/admin/users/${currentUserForDisable2FA.id}/disable-2fa`, {
      method: 'DELETE',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      }
    });

    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}));
      throw new Error(errorData.error || `HTTP ${response.status}`);
    }

    const result = await response.json();
    console.log('2FA disabled successfully:', result);

    // Show success state
    showDisable2FAState('success');

    // Auto-close after 3 seconds and refresh user data
    setTimeout(() => {
      hideDisable2FAModal();
      
      // Refresh user data
      if (typeof window.refreshUserData === 'function') {
        window.refreshUserData();
      } else {
        window.location.reload();
      }
    }, 3000);

  } catch (error) {
    console.error('Failed to disable 2FA:', error);
    showDisable2FAState('confirm');
    showDisable2FAError(error.message || 'Failed to disable 2FA');
  }
}

// Global function to open disable 2FA modal (called from button click)
window.openDisable2FAModal = function(user) {
  if (!user.totp_enabled) {
    alert('This user does not have 2FA enabled.');
    return;
  }
  showDisable2FAModal(user);
};

// Initialize on page load
document.addEventListener('DOMContentLoaded', () => {
  initializeDisable2FAModal();
});
  </script>
