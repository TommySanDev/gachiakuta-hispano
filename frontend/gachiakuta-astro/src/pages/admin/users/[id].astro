---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EditUserModal from '../../../components/admin/EditUserModal.astro';
import ResetPasswordModal from '../../../components/admin/ResetPasswordModal.astro';

// Only admins can access
export const prerender = false;

// Import auth functions directly
import type { AstroCookies } from 'astro';
import type { User } from '../../../types/auth';

const API_BASE_URL = import.meta.env.API_URL || 'http://localhost:8080';

async function getUserFromCookies(cookies: AstroCookies): Promise<User | null> {
  try {
    const token = cookies.get('auth_token')?.value;
    if (!token) return null;

    const response = await fetch(`${API_BASE_URL}/api/users/me`, {
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      }
    });

    if (!response.ok) {
      cookies.delete('auth_token', { path: '/' });
      cookies.delete('auth_user', { path: '/' });
      return null;
    }

    return await response.json();
  } catch (error) {
    console.error('Failed to validate user token:', error);
    return null;
  }
}

function userHasRole(user: User | null, requiredRole: string): boolean {
  if (!user) return false;
  switch (requiredRole) {
    case 'user': return true;
    case 'editor': return user.role === 'editor' || user.role === 'admin';
    case 'admin': return user.role === 'admin';
    default: return false;
  }
}

const currentUser = await getUserFromCookies(Astro.cookies);

if (!currentUser || !userHasRole(currentUser, 'admin')) {
  return Astro.redirect('/auth/login?error=admin-required');
}

// Get user ID from URL
const userId = Astro.params.id;
if (!userId || isNaN(Number(userId))) {
  return Astro.redirect('/admin/users?error=invalid-user-id');
}
---

<AdminLayout title="User Details - Admin Panel">
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-semibold text-white">User Details</h2>
        <p class="text-gray-300 text-sm">View and manage user information</p>
      </div>
      
      <a 
        href="/admin/users"
        class="bg-gray-600 hover:bg-gray-500 text-white px-4 py-2 rounded-md font-medium transition-colors flex items-center"
      >
        <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Users
      </a>
    </div>

    <!-- Loading State -->
    <div id="loading-state" class="text-center py-12">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-white mx-auto mb-4"></div>
      <p class="text-gray-300">Loading user details...</p>
    </div>

    <!-- Error State -->
    <div id="error-state" class="hidden text-center py-12">
      <div class="bg-red-100 rounded-full h-16 w-16 flex items-center justify-center mx-auto mb-4">
        <svg class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white mb-2">Failed to Load User</h3>
      <p id="error-message" class="text-gray-300 mb-4">User not found or access denied</p>
      <button
        id="retry-btn"
        class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md transition-colors"
      >
        Retry
      </button>
    </div>

    <!-- User Content -->
    <div id="user-content" class="hidden space-y-6">
      
      <!-- User Profile Card -->
      <div class="bg-gray-800 rounded-lg p-6">
        <div class="flex items-center space-x-6">
          <!-- Avatar -->
          <div id="user-avatar" class="h-20 w-20 rounded-full bg-gray-600 flex items-center justify-center">
            <span id="user-initials" class="text-2xl font-semibold text-white uppercase"></span>
          </div>
          
          <!-- Basic Info -->
          <div class="flex-1">
            <h3 id="user-name" class="text-2xl font-bold text-white mb-1"></h3>
            <p id="user-email" class="text-gray-300 mb-2"></p>
            <div class="flex items-center space-x-4">
              <span id="user-role-badge" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium"></span>
              <span id="user-status-badge" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium"></span>
            </div>
          </div>
          
          <!-- Quick Actions -->
          <div class="flex flex-col space-y-2">
            <button
              id="edit-user-btn"
              class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md font-medium transition-colors"
            >
              ✏️ Edit User
            </button>
            <button
              id="toggle-status-btn"
              class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md font-medium transition-colors"
            >
              ⚡ Toggle Status
            </button>
          </div>
        </div>
      </div>

      <!-- User Details Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Personal Information -->
        <div class="bg-gray-800 rounded-lg p-6">
          <h4 class="text-lg font-semibold text-white mb-4">Personal Information</h4>
          <div class="space-y-3">
            <div>
              <label class="block text-sm font-medium text-gray-400">Username</label>
              <p id="detail-username" class="text-white"></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-400">Full Name</label>
              <p id="detail-fullname" class="text-white"></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-400">Email Address</label>
              <p id="detail-email" class="text-white"></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-400">Role</label>
              <p id="detail-role" class="text-white"></p>
            </div>
          </div>
        </div>

        <!-- Account Status -->
        <div class="bg-gray-800 rounded-lg p-6">
          <h4 class="text-lg font-semibold text-white mb-4">Account Status</h4>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-gray-400">Account Active</span>
              <span id="status-active" class="text-sm font-medium"></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-gray-400">Email Verified</span>
              <span id="status-verified" class="text-sm font-medium"></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-gray-400">Magic Link Enabled</span>
              <span id="status-magic-link" class="text-sm font-medium"></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-gray-400">2FA Enabled</span>
              <span id="status-2fa" class="text-sm font-medium"></span>
            </div>
          </div>
        </div>

        <!-- Account Activity -->
        <div class="bg-gray-800 rounded-lg p-6">
          <h4 class="text-lg font-semibold text-white mb-4">Account Activity</h4>
          <div class="space-y-3">
            <div>
              <label class="block text-sm font-medium text-gray-400">Member Since</label>
              <p id="detail-created" class="text-white"></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-400">Last Login</label>
              <p id="detail-last-login" class="text-white"></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-400">Last Updated</label>
              <p id="detail-updated" class="text-white"></p>
            </div>
          </div>
        </div>

        <!-- Admin Actions -->
        <div class="bg-gray-800 rounded-lg p-6">
          <h4 class="text-lg font-semibold text-white mb-4">Admin Actions</h4>
          <div class="space-y-3">
            <button
              id="reset-password-btn"
              class="w-full bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded-md font-medium transition-colors"
            >
              🔒 Reset Password
            </button>
            <button
              id="disable-2fa-btn"
              class="w-full bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-md font-medium transition-colors"
            >
              🔐 Disable 2FA
            </button>
            <button
              id="delete-user-btn"
              class="w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md font-medium transition-colors"
            >
              🗑️ Delete User
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Include Edit User Modal -->
  <EditUserModal />
  
<!-- Admin Disable 2FA Modal -->
<div id="disable-2fa-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-gray-800 rounded-lg max-w-md w-full">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between p-6 border-b border-gray-600">
      <h2 class="text-xl font-semibold text-white flex items-center">
        <svg class="h-6 w-6 mr-2 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        Disable 2FA
      </h2>
      <button 
        id="close-disable-2fa-modal"
        class="text-gray-400 hover:text-white transition-colors"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Content -->
    <div class="p-6">
      
      <!-- Loading State -->
      <div id="disable-2fa-loading" class="hidden text-center py-8">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-orange-400 mx-auto mb-4"></div>
        <p class="text-white">Disabling 2FA...</p>
      </div>

      <!-- Confirmation State -->
      <div id="disable-2fa-confirm">
        <!-- Warning Section -->
        <div class="bg-orange-100 border border-orange-400 text-orange-800 px-4 py-3 rounded mb-6">
          <div class="flex items-start">
            <svg class="h-5 w-5 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <div>
              <h3 class="font-semibold">⚠️ Security Warning</h3>
              <p class="text-sm mt-1">
                This will completely disable two-factor authentication for this user, making their account less secure.
              </p>
            </div>
          </div>
        </div>

        <!-- User Info -->
        <div class="mb-6">
          <h3 class="text-white font-medium mb-2">Disabling 2FA for:</h3>
          <div class="bg-gray-700 p-4 rounded">
            <div class="flex items-center space-x-3">
              <div id="disable-2fa-user-avatar" class="h-10 w-10 rounded-full bg-gray-600 flex items-center justify-center">
                <span id="disable-2fa-user-initials" class="text-sm font-semibold text-white uppercase"></span>
              </div>
              <div>
                <div id="disable-2fa-user-name" class="text-white font-medium"></div>
                <div id="disable-2fa-user-email" class="text-gray-300 text-sm"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- What will happen -->
        <div class="mb-6">
          <h3 class="text-white font-medium mb-3">This action will:</h3>
          <ul class="space-y-2 text-sm text-gray-300">
            <li class="flex items-center">
              <svg class="h-4 w-4 mr-2 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
              Remove TOTP authenticator setup
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 mr-2 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
              Delete all recovery codes
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 mr-2 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
              Disable two-factor authentication completely
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 mr-2 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
              User will only have password protection
            </li>
          </ul>
        </div>

        <!-- Double confirmation -->
        <div class="mb-6">
          <label class="flex items-center">
            <input 
              type="checkbox" 
              id="disable-2fa-confirm-checkbox"
              class="h-4 w-4 text-orange-600 focus:ring-orange-500 border-gray-300 rounded"
            />
            <span class="ml-2 text-sm text-gray-300">
              I understand this will reduce account security and cannot be undone by the user
            </span>
          </label>
        </div>

        <!-- Error Message -->
        <div id="disable-2fa-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <div class="flex items-center">
            <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span id="disable-2fa-error-message"></span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center justify-end space-x-4">
          <button
            type="button"
            id="cancel-disable-2fa"
            class="bg-gray-600 hover:bg-gray-500 text-white px-6 py-3 rounded-md font-medium transition-colors"
          >
            Cancel
          </button>
          
          <button
            type="button"
            id="confirm-disable-2fa"
            class="bg-orange-600 hover:bg-orange-700 disabled:opacity-50 disabled:cursor-not-allowed text-white px-6 py-3 rounded-md font-medium transition-colors"
            disabled
          >
            <span id="disable-2fa-button-text">🔐 Disable 2FA</span>
          </button>
        </div>
      </div>

      <!-- Success State -->
      <div id="disable-2fa-success" class="hidden text-center py-8">
        <div class="bg-green-100 rounded-full h-16 w-16 flex items-center justify-center mx-auto mb-4">
          <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">2FA Disabled Successfully</h3>
        <p class="text-gray-300 mb-6">
          Two-factor authentication has been disabled for this user. They will no longer need authenticator codes to log in.
        </p>
        <button
          id="close-disable-2fa-success"
          class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-md font-medium transition-colors"
        >
          Close
        </button>
      </div>
    </div>
  </div>
</div>
  <!-- Include Reset Password Modal -->
  <ResetPasswordModal />
</AdminLayout>

  <script define:vars={{ userId }}>
    let currentUserData = null;

    // Elements
    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const userContent = document.getElementById('user-content');
    const errorMessage = document.getElementById('error-message');
    const retryBtn = document.getElementById('retry-btn');

    // Show different states
    function showLoading() {
      loadingState.classList.remove('hidden');
      errorState.classList.add('hidden');
      userContent.classList.add('hidden');
    }

    function showError(message) {
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
      userContent.classList.add('hidden');
      errorMessage.textContent = message;
    }

    function showUser() {
      loadingState.classList.add('hidden');
      errorState.classList.add('hidden');
      userContent.classList.remove('hidden');
    }

    // Format date
    function formatDate(dateString) {
      if (!dateString) return 'Never';
      return new Date(dateString).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    // Get role badge
    function getRoleBadge(role) {
      const colors = {
        admin: 'bg-red-100 text-red-800',
        editor: 'bg-blue-100 text-blue-800',
        user: 'bg-gray-100 text-gray-800'
      };
      return colors[role] || colors.user;
    }

    // Get status badge
    function getStatusBadge(isActive) {
      return isActive 
        ? 'bg-green-100 text-green-800' 
        : 'bg-red-100 text-red-800';
    }

    // Render user data
    function renderUser(user) {
      currentUserData = user;

      // Basic info
      document.getElementById('user-initials').textContent = 
        user.first_name.charAt(0) + user.last_name.charAt(0);
      document.getElementById('user-name').textContent = 
        `${user.first_name} ${user.last_name}`;
      document.getElementById('user-email').textContent = user.email;

      // Role badge
      const roleBadge = document.getElementById('user-role-badge');
      roleBadge.textContent = user.role.charAt(0).toUpperCase() + user.role.slice(1);
      roleBadge.className = `inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${getRoleBadge(user.role)}`;

      // Status badge
      const statusBadge = document.getElementById('user-status-badge');
      statusBadge.textContent = user.is_active ? 'Active' : 'Inactive';
      statusBadge.className = `inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${getStatusBadge(user.is_active)}`;

      // Details
      document.getElementById('detail-username').textContent = `@${user.username}`;
      document.getElementById('detail-fullname').textContent = `${user.first_name} ${user.last_name}`;
      document.getElementById('detail-email').textContent = user.email;
      document.getElementById('detail-role').textContent = user.role.charAt(0).toUpperCase() + user.role.slice(1);

      // Status indicators
      document.getElementById('status-active').textContent = user.is_active ? '✅ Yes' : '❌ No';
      document.getElementById('status-verified').textContent = user.email_verified ? '✅ Yes' : '⚠️ No';
      document.getElementById('status-magic-link').textContent = user.magic_link_enabled ? '✅ Yes' : '❌ No';
      document.getElementById('status-2fa').textContent = user.totp_enabled ? '✅ Yes' : '❌ No';

      // Dates
      document.getElementById('detail-created').textContent = formatDate(user.created_at);
      document.getElementById('detail-last-login').textContent = formatDate(user.last_login_at);
      document.getElementById('detail-updated').textContent = formatDate(user.updated_at);

      // Update button text
      document.getElementById('toggle-status-btn').textContent = 
        user.is_active ? '❌ Deactivate Account' : '✅ Activate Account';

      // Update 2FA button visibility
      const disable2faBtn = document.getElementById('disable-2fa-btn');
      if (user.totp_enabled) {
        disable2faBtn.style.display = 'block';
      } else {
        disable2faBtn.style.display = 'none';
      }
    }

    // Load user data
    async function loadUser() {
      showLoading();

      try {
        const token = document.cookie
          .split('; ')
          .find(row => row.startsWith('auth_token='))
          ?.split('=')[1];

        if (!token) {
          throw new Error('Authentication required');
        }

        console.log('Loading user:', userId);

        const response = await fetch(`http://localhost:8080/api/admin/users/${userId}`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.error || `User not found (HTTP ${response.status})`);
        }

        const user = await response.json();
        console.log('User loaded:', user);
        
        renderUser(user);
        showUser();

      } catch (error) {
        console.error('Failed to load user:', error);
        showError(error.message);
      }
    }

    // Refresh user data (called from modal after successful edit)
    window.refreshUserData = function() {
      loadUser();
    };

    // Generic admin action function
    async function performAdminAction(action, endpoint, confirmMessage, successMessage) {
      if (!currentUserData) return;

      if (confirmMessage && !confirm(confirmMessage)) {
        return;
      }

      try {
        const token = document.cookie
          .split('; ')
          .find(row => row.startsWith('auth_token='))
          ?.split('=')[1];

        if (!token) {
          alert('Authentication required');
          return;
        }

        console.log(`Performing action: ${action}`);

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.error || `${action} failed`);
        }

        alert(successMessage);
        loadUser(); // Refresh data

      } catch (error) {
        alert(`Failed to ${action.toLowerCase()}: ` + error.message);
      }
    }

    // Event listeners
    retryBtn.addEventListener('click', loadUser);

    // Edit user button
    document.getElementById('edit-user-btn').addEventListener('click', () => {
      if (currentUserData) {
        window.openEditUserModal(currentUserData);
      }
    });

    // Toggle status
