---
import AdminLayout from '../../../layouts/AdminLayout.astro';

// Only admins can access
export const prerender = false;

// Import auth functions directly
import type { AstroCookies } from 'astro';
import type { User } from '../../../types/auth';

const API_BASE_URL = import.meta.env.API_URL || 'http://localhost:8080';

async function getUserFromCookies(cookies: AstroCookies): Promise<User | null> {
  try {
    const token = cookies.get('auth_token')?.value;
    if (!token) return null;

    const response = await fetch(`${API_BASE_URL}/api/users/me`, {
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      }
    });

    if (!response.ok) {
      cookies.delete('auth_token', { path: '/' });
      cookies.delete('auth_user', { path: '/' });
      return null;
    }

    return await response.json();
  } catch (error) {
    console.error('Failed to validate user token:', error);
    return null;
  }
}

function userHasRole(user: User | null, requiredRole: string): boolean {
  if (!user) return false;
  switch (requiredRole) {
    case 'user': return true;
    case 'editor': return user.role === 'editor' || user.role === 'admin';
    case 'admin': return user.role === 'admin';
    default: return false;
  }
}

const user = await getUserFromCookies(Astro.cookies);

if (!user || !userHasRole(user, 'admin')) {
  return Astro.redirect('/auth/login?error=admin-required');
}
---

<AdminLayout title="Create User - Admin Panel">
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-semibold text-white">Create New User</h2>
        <p class="text-gray-300 text-sm">Add a new user to the platform</p>
      </div>
      
      <a 
        href="/admin/users"
        class="bg-gray-600 hover:bg-gray-500 text-white px-4 py-2 rounded-md font-medium transition-colors flex items-center"
      >
        <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Users
      </a>
    </div>

    <!-- Create User Form -->
    <div class="max-w-2xl">
      <form id="create-user-form" class="space-y-6">
        
        <!-- Success/Error Messages -->
        <div id="form-success" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
          <div class="flex items-center">
            <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span id="form-success-message"></span>
          </div>
        </div>

        <div id="form-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
          <div class="flex items-center">
            <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span id="form-error-message"></span>
          </div>
        </div>

        <!-- Personal Information -->
        <div class="bg-gray-800 p-6 rounded-lg">
          <h3 class="text-lg font-medium text-white mb-4">Personal Information</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-1">
                First Name <span class="text-red-400">*</span>
              </label>
              <input
                name="first_name"
                type="text"
                required
                placeholder="Enter first name"
                class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-700 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-300 mb-1">
                Last Name <span class="text-red-400">*</span>
              </label>
              <input
                name="last_name"
                type="text"
                required
                placeholder="Enter last name"
                class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-700 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-300 mb-1">
                Username <span class="text-red-400">*</span>
              </label>
              <input
                name="username"
                type="text"
                required
                placeholder="Choose a username"
                class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-700 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
              />
              <p class="text-xs text-gray-400 mt-1">Must be unique</p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-300 mb-1">
                Email <span class="text-red-400">*</span>
              </label>
              <input
                name="email"
                type="email"
                required
                placeholder="Enter email address"
                class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-700 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
              />
              <p class="text-xs text-gray-400 mt-1">Must be unique</p>
            </div>
          </div>
        </div>

        <!-- Account Settings -->
        <div class="bg-gray-800 p-6 rounded-lg">
          <h3 class="text-lg font-medium text-white mb-4">Account Settings</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-1">
                Password <span class="text-red-400">*</span>
              </label>
              <input
                name="password"
                type="password"
                required
                placeholder="Create a password"
                class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-700 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
              />
              <p class="text-xs text-gray-400 mt-1">Minimum 8 characters</p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-300 mb-1">
                Role <span class="text-red-400">*</span>
              </label>
              <select
                name="role"
                required
                class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-700 text-white focus:border-red-500 focus:ring-red-500"
              >
                <option value="">Select a role</option>
                <option value="user">User</option>
                <option value="editor">Editor</option>
                <option value="admin">Admin</option>
              </select>
              <p class="text-xs text-gray-400 mt-1">Determines user permissions</p>
            </div>
          </div>
        </div>

        <!-- Additional Options -->
        <div class="bg-gray-800 p-6 rounded-lg">
          <h3 class="text-lg font-medium text-white mb-4">Additional Options</h3>
          
          <div class="space-y-4">
            <div class="flex items-center">
              <input
                id="magic_link_enabled"
                name="magic_link_enabled"
                type="checkbox"
                class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded"
              />
              <label for="magic_link_enabled" class="ml-2 block text-sm text-gray-300">
                Enable magic link login (passwordless)
              </label>
            </div>

            <div class="flex items-center">
              <input
                id="email_verified"
                name="email_verified"
                type="checkbox"
                checked
                class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded"
              />
              <label for="email_verified" class="ml-2 block text-sm text-gray-300">
                Mark email as verified (skip verification step)
              </label>
            </div>

            <div class="flex items-center">
              <input
                id="is_active"
                name="is_active"
                type="checkbox"
                checked
                class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded"
              />
              <label for="is_active" class="ml-2 block text-sm text-gray-300">
                Account active (user can login)
              </label>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex items-center justify-end space-x-4">
          <a
            href="/admin/users"
            class="bg-gray-600 hover:bg-gray-500 text-white px-6 py-3 rounded-md font-medium transition-colors"
          >
            Cancel
          </a>
          
          <button
            type="submit"
            id="submit-btn"
            class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-md font-medium transition-colors"
          >
            <span id="submit-text">Create User</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('create-user-form') as HTMLFormElement;
    const successDiv = document.getElementById('form-success') as HTMLDivElement;
    const successMessage = document.getElementById('form-success-message') as HTMLSpanElement;
    const errorDiv = document.getElementById('form-error') as HTMLDivElement;
    const errorMessage = document.getElementById('form-error-message') as HTMLSpanElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitText = document.getElementById('submit-text') as HTMLSpanElement;

    // Show/hide messages
    function showSuccess(message: string) {
      successMessage.textContent = message;
      successDiv.classList.remove('hidden');
      errorDiv.classList.add('hidden');
    }

    function showError(message: string) {
      errorMessage.textContent = message;
      errorDiv.classList.remove('hidden');
      successDiv.classList.add('hidden');
    }

    function hideMessages() {
      successDiv.classList.add('hidden');
      errorDiv.classList.add('hidden');
    }

    // Set loading state
    function setLoading(loading: boolean) {
      submitBtn.disabled = loading;
      submitText.textContent = loading ? 'Creating...' : 'Create User';
    }

    // Handle form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMessages();

      const formData = new FormData(form);
      
      // Build user data
      const userData = {
        email: formData.get('email') as string,
        username: formData.get('username') as string,
        password: formData.get('password') as string,
        first_name: formData.get('first_name') as string,
        last_name: formData.get('last_name') as string,
        role: formData.get('role') as string,
        magic_link_enabled: formData.get('magic_link_enabled') === 'on'
      };

      // Basic validation
      if (!userData.email || !userData.username || !userData.password || 
          !userData.first_name || !userData.last_name || !userData.role) {
        showError('All required fields must be filled');
        return;
      }

      if (userData.password.length < 8) {
        showError('Password must be at least 8 characters long');
        return;
      }

      try {
        setLoading(true);

        // Get token from cookies
        const token = document.cookie
          .split('; ')
          .find(row => row.startsWith('auth_token='))
          ?.split('=')[1];

        if (!token) {
          throw new Error('Authentication required');
        }

        console.log('Creating user:', userData);

        const response = await fetch('http://localhost:8080/api/admin/users', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(userData)
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.error || `HTTP ${response.status}`);
        }

        const createdUser = await response.json();
        console.log('User created successfully:', createdUser);

        showSuccess(`User "${userData.username}" created successfully! Redirecting...`);
        
        // Clear form
        form.reset();
        
        // Redirect after 2 seconds
        setTimeout(() => {
          window.location.href = '/admin/users';
        }, 2000);

      } catch (error) {
        console.error('Create user error:', error);
        showError(error instanceof Error ? error.message : 'Failed to create user');
      } finally {
        setLoading(false);
      }
    });

    // Real-time validation for username and email
    const usernameInput = form.querySelector('input[name="username"]') as HTMLInputElement;
    const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement;

    // Simple username validation
    usernameInput.addEventListener('input', () => {
      const value = usernameInput.value;
      if (value.length > 0 && value.length < 3) {
        usernameInput.setCustomValidity('Username must be at least 3 characters');
      } else if (!/^[a-zA-Z0-9_-]+$/.test(value) && value.length > 0) {
        usernameInput.setCustomValidity('Username can only contain letters, numbers, underscores, and hyphens');
      } else {
        usernameInput.setCustomValidity('');
      }
    });

    // Password validation
    const passwordInput = form.querySelector('input[name="password"]') as HTMLInputElement;
    passwordInput.addEventListener('input', () => {
      const value = passwordInput.value;
      if (value.length > 0 && value.length < 8) {
        passwordInput.setCustomValidity('Password must be at least 8 characters');
      } else {
        passwordInput.setCustomValidity('');
      }
    });
  </script>
</AdminLayout>
