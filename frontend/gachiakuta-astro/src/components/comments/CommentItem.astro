---
import type { Comment } from '../../types/comment';
import { getUserFromCookies } from '../../lib/auth-server';

interface Props {
  comment: Comment;
}

const { comment } = Astro.props;
const currentUser = await getUserFromCookies(Astro.cookies);
const canEdit = currentUser && (currentUser.id === comment.user_id || currentUser.role === 'admin' || currentUser.role === 'editor');

// Format date
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
};
---

<div class="comment-item bg-gray-800 p-4 rounded-lg mb-4" data-comment-id={comment.id}>
  <!-- Comment header -->
  <div class="flex items-center justify-between mb-2">
    <div class="flex items-center space-x-2">
      <div class="h-8 w-8 rounded-full bg-gray-600 flex items-center justify-center">
        <span class="text-xs font-semibold text-white uppercase">
          {comment.first_name.charAt(0)}{comment.last_name.charAt(0)}
        </span>
      </div>
      <div>
        <span class="text-white font-medium">{comment.first_name} {comment.last_name}</span>
        <span class="text-gray-400 text-sm ml-2">@{comment.username}</span>
      </div>
    </div>
    <div class="flex items-center space-x-2">
      <span class="text-gray-400 text-sm">{formatDate(comment.created_at)}</span>
      {canEdit && (
        <div class="comment-actions space-x-2">
          <button 
            class="edit-comment-btn text-blue-400 hover:text-blue-300 text-sm"
            data-comment-id={comment.id}
          >
            Edit
          </button>
          <button 
            class="delete-comment-btn text-red-400 hover:text-red-300 text-sm"
            data-comment-id={comment.id}
          >
            Delete
          </button>
        </div>
      )}
    </div>
  </div>

  <!-- Comment content -->
  <div class="comment-content">
    <p class="text-gray-300 comment-text">{comment.content}</p>
  </div>

  <!-- Edit form (hidden by default) -->
  <div class="edit-form hidden mt-3">
    <form class="edit-comment-form" data-comment-id={comment.id}>
      <textarea 
        class="w-full bg-gray-700 text-white rounded p-2 border border-gray-600 focus:border-red-500 resize-none"
        rows="3"
        name="content"
        required
      >{comment.content}</textarea>
      <div class="flex justify-end space-x-2 mt-2">
        <button 
          type="button" 
          class="cancel-edit-btn bg-gray-600 hover:bg-gray-500 text-white px-3 py-1 rounded text-sm"
        >
          Cancel
        </button>
        <button 
          type="submit" 
          class="save-edit-btn bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import { updateComment, deleteComment } from '../../lib/comment-api';
  import { authToken } from '../../lib/auth-store';

  // Edit comment functionality
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Edit button clicked
    if (target.classList.contains('edit-comment-btn')) {
      const commentId = target.dataset.commentId;
      const commentItem = document.querySelector(`[data-comment-id="${commentId}"]`);
      if (commentItem) {
        const content = commentItem.querySelector('.comment-content');
        const editForm = commentItem.querySelector('.edit-form');
        const actions = commentItem.querySelector('.comment-actions');
        
        content?.classList.add('hidden');
        editForm?.classList.remove('hidden');
        actions?.classList.add('hidden');
      }
    }

    // Cancel edit
    if (target.classList.contains('cancel-edit-btn')) {
      const form = target.closest('.edit-comment-form') as HTMLFormElement;
      const commentId = form?.dataset.commentId;
      const commentItem = document.querySelector(`[data-comment-id="${commentId}"]`);
      
      if (commentItem) {
        const content = commentItem.querySelector('.comment-content');
        const editForm = commentItem.querySelector('.edit-form');
        const actions = commentItem.querySelector('.comment-actions');
        
        content?.classList.remove('hidden');
        editForm?.classList.add('hidden');
        actions?.classList.remove('hidden');
      }
    }

    // Delete button clicked
    if (target.classList.contains('delete-comment-btn')) {
      const commentId = target.dataset.commentId;
      if (commentId && confirm('Are you sure you want to delete this comment?')) {
        try {
          const token = authToken.value;
          if (!token) throw new Error('Authentication required');
          
          await deleteComment(commentId, token);
          
          // Remove from DOM
          const commentItem = document.querySelector(`[data-comment-id="${commentId}"]`);
          commentItem?.remove();
          
          alert('Comment deleted successfully');
        } catch (error) {
          console.error('Delete failed:', error);
          alert('Failed to delete comment');
        }
      }
    }
  });

  // Handle edit form submission
  document.addEventListener('submit', async (e) => {
    const target = e.target as HTMLFormElement;
    
    if (target.classList.contains('edit-comment-form')) {
      e.preventDefault();
      
      const commentId = target.dataset.commentId;
      const formData = new FormData(target);
      const content = formData.get('content') as string;
      
      if (!commentId || !content.trim()) return;
      
      try {
        const token = authToken.value;
        if (!token) throw new Error('Authentication required');
        
        const updatedComment = await updateComment(commentId, { content }, token);
        
        // Update DOM
        const commentItem = document.querySelector(`[data-comment-id="${commentId}"]`);
        if (commentItem) {
          const textElement = commentItem.querySelector('.comment-text');
          if (textElement) textElement.textContent = updatedComment.content;
          
          const contentDiv = commentItem.querySelector('.comment-content');
          const editForm = commentItem.querySelector('.edit-form');
          const actions = commentItem.querySelector('.comment-actions');
          
          contentDiv?.classList.remove('hidden');
          editForm?.classList.add('hidden');
          actions?.classList.remove('hidden');
        }
        
        alert('Comment updated successfully');
      } catch (error) {
        console.error('Update failed:', error);
        alert('Failed to update comment');
      }
    }
  });
</script>
