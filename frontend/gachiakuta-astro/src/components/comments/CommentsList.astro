---
import { getCommentsByChapter } from '../../lib/comment-api';
import CommentItem from './CommentItem.astro';

interface Props {
  chapterId: string;
}

const { chapterId } = Astro.props;

let comments = [];

try {
  comments = await getCommentsByChapter(chapterId);
} catch (error) {
  console.error('Failed to load comments:', error);
}
---

<div class="comments-list">
  <div class="flex items-center justify-between mb-6">
    <h3 class="text-white text-xl font-semibold">
      Comments ({comments.length})
    </h3>
    
    {comments.length > 0 && (
      <button 
        id="refresh-comments"
        class="text-gray-400 hover:text-white text-sm flex items-center space-x-1"
        title="Refresh comments"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Refresh</span>
      </button>
    )}
  </div>

  {comments.length === 0 ? (
    <div class="text-center py-12">
      <div class="text-gray-400 mb-2">
        <svg class="h-12 w-12 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      </div>
      <p class="text-gray-400 text-lg">No comments yet</p>
      <p class="text-gray-500 text-sm mt-2">Be the first to share your thoughts about this chapter!</p>
    </div>
  ) : (
    <div class="space-y-4">
      {comments.map((comment) => (
        <CommentItem comment={comment} />
      ))}
    </div>
  )}
</div>

<script>
  // Refresh comments button
  document.getElementById('refresh-comments')?.addEventListener('click', () => {
    window.location.reload();
  });
</script>
