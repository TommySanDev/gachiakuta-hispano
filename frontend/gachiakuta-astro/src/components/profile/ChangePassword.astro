---
import ProfileMessages from './ProfileMessages.astro';
---

<div class="bg-black bg-opacity-40 backdrop-blur-sm rounded-lg p-6 shadow-xl border border-gray-600">
  <h3 class="text-lg font-semibold text-white mb-4">Change Password</h3>
  
  <ProfileMessages successId="password-success" errorId="password-error" />

  <!-- Password view (default) -->
  <div id="password-view">
    <p class="text-gray-300 text-sm mb-4">
      Update your password to keep your account secure.
    </p>
    <button 
      id="change-password-btn"
      class="bg-gray-800 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded-md transition-colors"
    >
      Change Password
    </button>
  </div>

  <!-- Password change form (hidden by default) -->
  <form id="password-change-form" class="hidden space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-300 mb-1">
        Current Password <span class="text-red-400">*</span>
      </label>
      <input 
        name="current_password"
        type="password"
        required
        placeholder="Enter your current password"
        class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-300 mb-1">
        New Password <span class="text-red-400">*</span>
      </label>
      <input 
        id="new-password-input"
        name="new_password"
        type="password"
        required
        placeholder="Enter your new password"
        class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
      />
      <p class="text-xs text-gray-400 mt-1">Minimum 8 characters</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-300 mb-1">
        Confirm New Password <span class="text-red-400">*</span>
      </label>
      <input 
        id="confirm-password-input"
        name="confirm_password"
        type="password"
        required
        placeholder="Confirm your new password"
        class="block w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-white placeholder-gray-400 focus:border-red-500 focus:ring-red-500"
      />
    </div>

    <div class="flex items-center space-x-4 pt-4">
      <button 
        type="submit"
        id="save-password-btn"
        class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-6 rounded-md transition-colors"
      >
        <span id="save-password-text">Update Password</span>
      </button>
      <button 
        type="button"
        id="cancel-password-btn"
        class="bg-gray-600 hover:bg-gray-500 text-white font-medium py-2 px-4 rounded-md transition-colors"
      >
        Cancel
      </button>
    </div>
  </form>
</div>

<script>
  import { changePassword } from '../../lib/profile/profile-actions';
  import { profileMessages } from '../../lib/profile/profile-store';

  const changePasswordBtn = document.getElementById('change-password-btn');
  const passwordView = document.getElementById('password-view');
  const passwordChangeForm = document.getElementById('password-change-form') as HTMLFormElement;
  const cancelPasswordBtn = document.getElementById('cancel-password-btn');
  const savePasswordBtn = document.getElementById('save-password-btn') as HTMLButtonElement;
  const savePasswordText = document.getElementById('save-password-text');

  function togglePasswordEditMode(editing: boolean) {
    if (editing) {
      passwordView?.classList.add('hidden');
      passwordChangeForm?.classList.remove('hidden');
    } else {
      passwordView?.classList.remove('hidden');
      passwordChangeForm?.classList.add('hidden');
      profileMessages.hideMessages('password');
    }
  }

  function setPasswordLoading(loading: boolean) {
    if (savePasswordBtn && savePasswordText) {
      savePasswordBtn.disabled = loading;
      savePasswordText.textContent = loading ? 'Updating...' : 'Update Password';
    }
  }

  // Event Listeners
  changePasswordBtn?.addEventListener('click', () => {
    togglePasswordEditMode(true);
  });

  cancelPasswordBtn?.addEventListener('click', () => {
    togglePasswordEditMode(false);
    passwordChangeForm?.reset();
  });

  passwordChangeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    profileMessages.hideMessages('password');

    const formData = new FormData(passwordChangeForm);
    const currentPassword = formData.get('current_password') as string;
    const newPassword = formData.get('new_password') as string;
    const confirmPassword = formData.get('confirm_password') as string;

    // Validation
    if (!currentPassword || !newPassword || !confirmPassword) {
      profileMessages.showError('password', 'All fields are required');
      return;
    }

    if (newPassword.length < 8) {
      profileMessages.showError('password', 'New password must be at least 8 characters');
      return;
    }

    if (newPassword !== confirmPassword) {
      profileMessages.showError('password', 'New passwords do not match');
      return;
    }

    if (currentPassword === newPassword) {
      profileMessages.showError('password', 'New password must be different from current password');
      return;
    }

    try {
      setPasswordLoading(true);
      
      await changePassword({
        current_password: currentPassword,
        new_password: newPassword
      });

      profileMessages.showSuccess('password', 'Password updated successfully!');
      
      passwordChangeForm.reset();
      setTimeout(() => {
        togglePasswordEditMode(false);
      }, 2000);

    } catch (error) {
      const message = error instanceof Error ? error.message : 'Failed to update password';
      profileMessages.showError('password', message);
    } finally {
      setPasswordLoading(false);
    }
  });

  // Real-time password validation
  const newPasswordInput = document.getElementById('new-password-input') as HTMLInputElement;
  const confirmPasswordInput = document.getElementById('confirm-password-input') as HTMLInputElement;

  newPasswordInput?.addEventListener('input', () => {
    const value = newPasswordInput.value;
    if (value.length > 0 && value.length < 8) {
      newPasswordInput.setCustomValidity('Password must be at least 8 characters');
    } else {
      newPasswordInput.setCustomValidity('');
    }
    
    // Check confirm password if it has a value
    if (confirmPasswordInput.value && confirmPasswordInput.value !== value) {
      confirmPasswordInput.setCustomValidity('Passwords do not match');
    } else if (confirmPasswordInput.value) {
      confirmPasswordInput.setCustomValidity('');
    }
  });

  confirmPasswordInput?.addEventListener('input', () => {
    const newPassword = newPasswordInput.value;
    const confirmPassword = confirmPasswordInput.value;
    
    if (confirmPassword && newPassword !== confirmPassword) {
      confirmPasswordInput.setCustomValidity('Passwords do not match');
    } else {
      confirmPasswordInput.setCustomValidity('');
    }
  });
</script>
