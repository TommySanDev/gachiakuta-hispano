---
// Modal component for displaying temporary password after admin reset
---

<!-- Reset Password Modal -->
<div id="reset-password-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-gray-800 rounded-lg max-w-md w-full">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between p-6 border-b border-gray-600">
      <h2 class="text-xl font-semibold text-white">Password Reset</h2>
      <button 
        id="close-reset-modal-btn"
        class="text-gray-400 hover:text-white transition-colors"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Content -->
    <div class="p-6">
      
      <!-- Success State -->
      <div id="reset-success-content" class="hidden text-center">
        <div class="bg-green-100 rounded-full h-16 w-16 flex items-center justify-center mx-auto mb-4">
          <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        
        <h3 class="text-lg font-semibold text-white mb-2">Password Reset Successfully</h3>
        <p class="text-gray-300 text-sm mb-6">
          A temporary password has been generated for <span id="reset-user-info" class="font-medium text-white"></span>
        </p>

        <!-- Temporary Password Display -->
        <div class="bg-gray-700 border-2 border-yellow-500 rounded-lg p-4 mb-6">
          <label class="block text-sm font-medium text-yellow-400 mb-2">
            🔑 Temporary Password
          </label>
          <div class="flex items-center space-x-2">
            <input
              id="temp-password-display"
              type="text"
              readonly
              class="flex-1 bg-gray-900 text-white font-mono text-lg px-3 py-2 rounded border border-gray-600 text-center"
            />
            <button
              id="copy-password-btn"
              class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded transition-colors"
              title="Copy to clipboard"
            >
              📋
            </button>
          </div>
        </div>

        <!-- Instructions -->
        <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-6 text-left">
          <div class="flex items-start">
            <svg class="h-5 w-5 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <div>
              <h4 class="font-medium">Important Instructions:</h4>
              <ul class="text-sm mt-1 space-y-1">
                <li>• Provide this password to the user securely</li>
                <li>• The user should change it on first login</li>
                <li>• This password is temporary and expires in 24 hours</li>
                <li>• Do not share via email or unsecured channels</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center justify-center space-x-4">
          <button
            id="download-password-btn"
            class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md font-medium transition-colors"
          >
            📥 Download Info
          </button>
          
          <button
            id="close-reset-success-btn"
            class="bg-gray-600 hover:bg-gray-500 text-white px-4 py-2 rounded-md font-medium transition-colors"
          >
            Close
          </button>
        </div>
      </div>

      <!-- Loading State -->
      <div id="reset-loading-content" class="hidden text-center py-8">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-white mx-auto mb-4"></div>
        <p class="text-white">Generating temporary password...</p>
      </div>

      <!-- Error State -->
      <div id="reset-error-content" class="hidden text-center">
        <div class="bg-red-100 rounded-full h-16 w-16 flex items-center justify-center mx-auto mb-4">
          <svg class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        
        <h3 class="text-lg font-semibold text-white mb-2">Reset Failed</h3>
        <p id="reset-error-message" class="text-gray-300 mb-6">
          Failed to reset password. Please try again.
        </p>

        <div class="flex items-center justify-center space-x-4">
          <button
            id="retry-reset-btn"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md font-medium transition-colors"
          >
            Try Again
          </button>
          
          <button
            id="close-reset-error-btn"
            class="bg-gray-600 hover:bg-gray-500 text-white px-4 py-2 rounded-md font-medium transition-colors"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let currentResetUser: any = null;
  let currentTempPassword: string = '';

  // Elements
  const resetModal = document.getElementById('reset-password-modal');
  const closeModalBtn = document.getElementById('close-reset-modal-btn');
  const successContent = document.getElementById('reset-success-content');
  const loadingContent = document.getElementById('reset-loading-content');
  const errorContent = document.getElementById('reset-error-content');
  const tempPasswordDisplay = document.getElementById('temp-password-display') as HTMLInputElement;
  const copyPasswordBtn = document.getElementById('copy-password-btn');
  const downloadPasswordBtn = document.getElementById('download-password-btn');
  const resetUserInfo = document.getElementById('reset-user-info');
  const resetErrorMessage = document.getElementById('reset-error-message');

  // Show/hide functions
  function showResetModal() {
    resetModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function hideResetModal() {
    resetModal?.classList.add('hidden');
    document.body.style.overflow = '';
    
    // Reset modal state
    successContent?.classList.add('hidden');
    loadingContent?.classList.add('hidden');
    errorContent?.classList.add('hidden');
    currentResetUser = null;
    currentTempPassword = '';
  }

  function showLoading() {
    successContent?.classList.add('hidden');
    loadingContent?.classList.remove('hidden');
    errorContent?.classList.add('hidden');
  }

  function showSuccess(user: any, tempPassword: string) {
    currentTempPassword = tempPassword;
    
    // Update display
    if (tempPasswordDisplay) tempPasswordDisplay.value = tempPassword;
    if (resetUserInfo) resetUserInfo.textContent = `${user.first_name} ${user.last_name} (${user.email})`;
    
    // Show success state
    loadingContent?.classList.add('hidden');
    errorContent?.classList.add('hidden');
    successContent?.classList.remove('hidden');
  }

  function showError(message: string) {
    if (resetErrorMessage) resetErrorMessage.textContent = message;
    
    loadingContent?.classList.add('hidden');
    successContent?.classList.add('hidden');
    errorContent?.classList.remove('hidden');
  }

  // Copy to clipboard
  async function copyToClipboard(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      
      // Show feedback
      if (copyPasswordBtn) {
        const originalText = copyPasswordBtn.textContent;
        copyPasswordBtn.textContent = '✅';
        copyPasswordBtn.classList.add('bg-green-600');
        copyPasswordBtn.classList.remove('bg-blue-600');
        
        setTimeout(() => {
          copyPasswordBtn.textContent = originalText;
          copyPasswordBtn.classList.remove('bg-green-600');
          copyPasswordBtn.classList.add('bg-blue-600');
        }, 1500);
      }
    } catch (err) {
      // Fallback for older browsers
      tempPasswordDisplay?.select();
      document.execCommand('copy');
      alert('Password copied to clipboard!');
    }
  }

  // Download password info
  function downloadPasswordInfo() {
    if (!currentResetUser || !currentTempPassword) return;

    const content = `Gachiakuta Hispano - Password Reset Information

User Information:
- Name: ${currentResetUser.first_name} ${currentResetUser.last_name}
- Email: ${currentResetUser.email}
- Username: ${currentResetUser.username}

Temporary Password: ${currentTempPassword}

IMPORTANT INSTRUCTIONS:
1. Provide this password to the user through a secure channel
2. The user must change this password on first login
3. This password expires in 24 hours
4. Do not share via email or unsecured channels

Reset performed by: Admin
Reset date: ${new Date().toLocaleString()}

This is a temporary password generated by the admin panel.
`;

    const blob = new Blob([content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `password-reset-${currentResetUser.username}-${new Date().toISOString().split('T')[0]}.txt`;
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // Perform password reset
  async function performPasswordReset(user: any) {
    currentResetUser = user;
    showResetModal();
    showLoading();

    try {
      const token = document.cookie
        .split('; ')
        .find(row => row.startsWith('auth_token='))
        ?.split('=')[1];

      if (!token) {
        throw new Error('Authentication required');
      }

      console.log('Resetting password for user:', user.id);

      const response = await fetch(`http://localhost:8080/api/admin/users/${user.id}/reset-password`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        throw new Error(errorData.error || `HTTP ${response.status}`);
      }

      const result = await response.json();
      console.log('Password reset successful:', result);

      showSuccess(user, result.temporary_password);

    } catch (error) {
      console.error('Password reset error:', error);
      showError(error instanceof Error ? error.message : 'Failed to reset password');
    }
  }

  // Global function to trigger password reset
  (window as any).resetUserPassword = function(user: any) {
    if (!confirm(`Are you sure you want to reset the password for "${user.username}"?\n\nThis will generate a new temporary password and invalidate their current password.`)) {
      return;
    }
    performPasswordReset(user);
  };

  // Event Listeners
  closeModalBtn?.addEventListener('click', hideResetModal);
  document.getElementById('close-reset-success-btn')?.addEventListener('click', hideResetModal);
  document.getElementById('close-reset-error-btn')?.addEventListener('click', hideResetModal);

  copyPasswordBtn?.addEventListener('click', () => {
    if (currentTempPassword) {
      copyToClipboard(currentTempPassword);
    }
  });

  downloadPasswordBtn?.addEventListener('click', downloadPasswordInfo);

  document.getElementById('retry-reset-btn')?.addEventListener('click', () => {
    if (currentResetUser) {
      performPasswordReset(currentResetUser);
    }
  });

  // Close modal when clicking outside
  resetModal?.addEventListener('click', (e) => {
    if (e.target === resetModal) {
      hideResetModal();
    }
  });
</script>
