---
import CardImage from './CardImage.astro';
import CardName from './CardName.astro';
import { imageMap } from '../lib/image-map';

interface Props {
  imageUrl: string;
  name: string;
}

const { imageUrl, name } = Astro.props;
const imageFilename = imageUrl.split('/').pop();
const mappedImage = imageFilename ? imageMap[imageFilename] : undefined;
const finalImage = mappedImage ?? imageUrl;
---

<div class="content-card">
  <div class="card-container">
    <CardImage image={finalImage} name={name} />
    <CardName name={name} />
  </div>
</div>


<style>
  .content-card {
    position: relative;
    margin-bottom: 2rem;
    perspective: 1000px;
    background: transparent;
    overflow: visible;
    display: inline-block;
  }

  .card-container {
    width: 240px;
    height: 320px;
    transition: all 0.4s ease-in-out;
    transform-origin: center center;
    position: relative;
    background: transparent;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform-style: preserve-3d;
    will-change: transform;
    z-index: 1;
  }

  .card-container:hover {
    transform: scale(1.25);
    z-index: 10;
    filter: brightness(1.1);
  }

  .content-card:hover ~ .content-card .card-container {
    transform: scale(0.7);
    opacity: 0.4;
    filter: brightness(0.6);
    z-index: 0;
  }

  .content-card:hover .card-container {
    z-index: 20;
  }
</style>

