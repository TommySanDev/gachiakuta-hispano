---
import Layout from './Layout.astro';

interface Props {
  title?: string;
}

const { title = "Gachiakuta Hispano - TV" } = Astro.props;
---

<Layout title={title}>
  <div class="tv-container">
    <!-- Pantalla principal -->
    <div class="tv-screen">
      <div class="screen-content">
        <slot />
      </div>
    </div>

    <!-- Controles inferiores -->
    <div class="tv-controls">
      <button class="control-button" title="Power"></button>
      <div class="knob" title="Volumen"></div>
      <div class="knob" title="Canal"></div>
      <button class="control-button" title="Menu"></button>
    </div>
  </div>
</Layout>

<style>
  /* Contenedor principal TV */
  .tv-container {
    width: 100vw;
    height: 100vh;
    background-color: #8B7355;
    padding: 60px;
    padding-bottom: 10px;
    display: flex;
    flex-direction: column;
  }

  /* Pantalla */
  .tv-screen {
    flex: 1;
    background-color: #1a1a1a;
    border: 10px solid #6B5843;
    border-radius: 5px;
    overflow: hidden;
    position: relative;
  }

  /* Contenido de la pantalla */
  .screen-content {
    background-color: #222;
    color: #ddd;
    padding: 20px;
    height: 100%;
    overflow-y: auto;
  }

  /* Panel de control inferior */
  .tv-controls {
    display: flex;
    gap: 20px;
    margin-top: 10px;
    justify-content: center;
    align-items: center;
    height: 60px;
  }

  /* Botones simples */
  .control-button {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background-color: #4A3B2C;
    border: 2px solid #3d2b1a;
    cursor: pointer;
    transition: transform 0.1s;
  }

  .control-button:hover {
    transform: scale(0.95);
  }

  /* Perilla */
  .knob {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #4A3B2C;
    border: 2px solid #3d2b1a;
    position: relative;
    cursor: pointer;
  }

  .knob::after {
    content: '';
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 3px;
    height: 20px;
    background-color: #fff;
    border-radius: 2px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .tv-container {
      padding: 40px;
      padding-bottom: 10px;
    }

    .tv-controls {
      gap: 10px;
      height: 50px;
    }

    .control-button {
      width: 40px;
      height: 40px;
    }

    .knob {
      width: 45px;
      height: 45px;
    }

    .screen-content {
      padding: 15px;
    }
  }

  @media (max-width: 480px) {
    .tv-container {
      padding: 30px;
      padding-bottom: 10px;
    }
  }
</style>
