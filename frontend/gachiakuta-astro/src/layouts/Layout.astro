---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Gachiakuta Hispano" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-red-800 text-white overflow-x-hidden font-sans">
    <main class="w-full min-h-screen">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;
  
  /* Estilos globales */
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  
  a {
    text-decoration: none;
  }
</style>
