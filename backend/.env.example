# Database Configuration
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=gachiakuta_fan_db
DB_HOST=localhost
DB_SSLMODE=disable

# Server Configuration
PORT=8080
ENVIRONMENT=development

# Paseto/Authentication Configuration
PASETO_SECRET=your-super-secret-paseto-key-here-make-it-long-and-secure-32-chars-min
TOKEN_EXPIRATION_HOURS=24
REFRESH_TOKEN_DAYS=30

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER=5

# Magic Link Configuration
MAGIC_LINK_ENABLED=true
MAGIC_LINK_EXPIRATION_MINUTES=15

# Password Reset Configuration
RESET_TOKEN_EXPIRATION_MINUTES=60

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# SMTP Configuration (Optional - for email features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@gachiakuta-hispano.com
SMTP_TLS=true
