# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gachiakuta_fan_db
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# Server Configuration
PORT=8080
ENVIRONMENT=development

# Paseto/Authentication Configuration
# INSECURE KEY - Generate secure one: head -c 32 /dev/urandom | base64
PASETO_SECRET=12345678901234567890123456789012
TOKEN_EXPIRATION_HOURS=24
REFRESH_TOKEN_DAYS=30

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER=5

# Magic Link Configuration
MAGIC_LINK_ENABLED=true
MAGIC_LINK_EXPIRATION_MINUTES=15

# Password Reset Configuration
RESET_TOKEN_EXPIRATION_MINUTES=60

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# URLs
FRONTEND_URL=http://localhost:4321
BACKEND_URL=http://localhost:8080

# SMTP Configuration (MailHog - para desarrollo y testing)
# Para usar: docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
# Interface web: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@gachiakuta-hispano.com
SMTP_TLS=false
